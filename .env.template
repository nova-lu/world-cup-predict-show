# ============================================
# 世界杯预测网站 - 环境变量配置模板
# 复制此文件为 .env 并填写真实值
# ============================================

# football-data.org API Key（赛事数据）
# 注册地址: https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# Odds-API.io API Key（赔率数据）
# 注册地址(old): https://the-odds-api.com/
# 注册地址: https://odds-api.io/
ODDS_API_KEY=

# 服务端口（默认 3000）
PORT=3000

# 运行环境（production / development）
NODE_ENV=production

# 代理配置（可选，用于绕过地域限制）
# 格式示例: http://127.0.0.1:7890
HTTPS_PROXY=

# ===== AI 分析引擎 =====
# DeepSeek API (或其他兼容 OpenAI 格式的 API)
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_API_BASE=https://api.deepseek.com
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_CACHE_TTL=3600
AI_TIMEOUT=30000
