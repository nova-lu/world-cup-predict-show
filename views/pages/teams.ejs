<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="page-header">
      <h1>球队信息库</h1>
      <p class="subtitle">2026世界杯 48支参赛球队</p>
    </div>
    <div id="loading-spinner" class="loading">加载中...</div>
    <div id="teams-grid" style="display:none"></div>
  </main>

  <%- include('../partials/footer') %>

  <script>
  fetch('/api/teams')
    .then(r => r.json())
    .then(data => {
      document.getElementById('loading-spinner').style.display = 'none';
      const grid = document.getElementById('teams-grid');
      grid.style.display = 'grid';

      const groups = {};
      data.teams.forEach(t => {
        const g = t.group || 'Z';
        if (!groups[g]) groups[g] = [];
        groups[g].push(t);
      });

      Object.keys(groups).sort().forEach(g => {
        const section = document.createElement('div');
        section.className = 'team-group-section';
        section.innerHTML = `<h2 class="group-title">${g}组</h2>`;
        const row = document.createElement('div');
        row.className = 'team-card-container';
        groups[g].forEach(t => {
          const card = document.createElement('a');
          card.href = `/teams/${t.slug}`;
          card.className = 'team-card';
          card.innerHTML = `
            <span class="team-flag">${t.flag || '⚽'}</span>
            <span class="team-cn-name">${t.name || t.slug}</span>
            <span class="team-en-name">${t.nameEn || ''}</span>
            <span class="team-elo">Elo ${t.elo || '-'}</span>
          `;
          row.appendChild(card);
        });
        section.appendChild(row);
        grid.appendChild(section);
      });
    });
  </script>
</body>
</html>
