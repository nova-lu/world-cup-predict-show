<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="page-header">
      <h1 id="match-title">加载中...</h1>
    </div>
    <div class="disclaimer-banner">
      ⚠️ 数学模型预测，仅供娱乐参考。足球比赛存在极大不确定性。
    </div>
    <div id="loading-spinner" class="loading">加载中...</div>

    <!-- 引擎选择器 -->
    <div class="engine-selector" id="engine-tabs">
      <button class="engine-tab active" data-engine="elo" onclick="switchEngine('elo')">Elo 经典</button>
      <button class="engine-tab" data-engine="ml" onclick="switchEngine('ml')">ML v1</button>
      <button class="engine-tab" data-engine="ensemble" onclick="switchEngine('ensemble')">集成</button>
    </div>

    <!-- Tab 导航 -->
    <nav class="tab-nav">
      <button class="tab-btn active" data-tab="conclusion" onclick="switchTab('conclusion')">📊 预测结论</button>
      <button class="tab-btn" data-tab="divergence" onclick="switchTab('divergence')">📈 市场分歧</button>
      <button class="tab-btn" data-tab="data" onclick="switchTab('data')">📋 数据详情</button>
    </nav>

    <!-- Tab: 预测结论（服务端/客户端预渲染） -->
    <div id="tab-conclusion" class="tab-content active">
      <div id="prediction-detail" style="display:none">
        <!-- 概率卡片 -->
        <div class="prediction-summary">
          <div class="prob-card prob-home-bg" id="win-home-card">
            <span class="prob-label">主胜</span>
            <span class="prob-value" id="win-home-pct">-%</span>
          </div>
          <div class="prob-card prob-draw-bg" id="draw-card">
            <span class="prob-label">平局</span>
            <span class="prob-value" id="draw-pct">-%</span>
          </div>
          <div class="prob-card prob-away-bg" id="win-away-card">
            <span class="prob-label">客胜</span>
            <span class="prob-value" id="win-away-pct">-%</span>
          </div>
        </div>

        <!-- 加时/点球概率分解（仅淘汰赛显示） -->
        <div id="knockout-breakdown" style="display:none;margin-top:6px;">
          <div class="info-section" style="padding:10px 14px;border-color:#2a3a4e;">
            <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
              <div class="kb-item"><span class="kb-label">常规时间</span><span class="kb-value" id="kb-reg">-%</span></div>
              <div class="kb-item"><span class="kb-label">加时赛</span><span class="kb-value" id="kb-et">-%</span></div>
              <div class="kb-item"><span class="kb-label">点球大战</span><span class="kb-value" id="kb-pk">-%</span></div>
            </div>
          </div>
        </div>

        <!-- 比赛信息条 -->
        <div class="info-section" id="match-info-bar" style="display:none">
          <div class="match-info-grid">
            <div class="match-info-item">
              <span class="info-label">阶段</span>
              <span class="info-value" id="mi-stage">-</span>
            </div>
            <div class="match-info-item">
              <span class="info-label">分组</span>
              <span class="info-value" id="mi-group">-</span>
            </div>
            <div class="match-info-item">
              <span class="info-label">比赛日</span>
              <span class="info-value" id="mi-matchday">-</span>
            </div>
            <div class="match-info-item">
              <span class="info-label">开球时间</span>
              <span class="info-value" id="mi-time">-</span>
            </div>
            <div class="match-info-item">
              <span class="info-label">状态</span>
              <span class="info-value" id="mi-status">-</span>
            </div>
            <div class="match-info-item">
              <span class="info-label">最终比分</span>
              <span class="info-value" id="mi-score">-</span>
            </div>
          </div>
        </div>

        <!-- 预期进球 -->
        <div class="info-section">
          <h2>预期进球 (xG)</h2>
          <div class="xg-bar-container">
            <div class="xg-row">
              <span class="xg-team" id="xg-home-name">-</span>
              <div class="xg-track"><div class="xg-fill xg-home-fill" id="xg-home-bar"></div></div>
              <span class="xg-value" id="xg-home-val">-</span>
            </div>
            <div class="xg-row">
              <span class="xg-team" id="xg-away-name">-</span>
              <div class="xg-track"><div class="xg-fill xg-away-fill" id="xg-away-bar"></div></div>
              <span class="xg-value" id="xg-away-val">-</span>
            </div>
          </div>
        </div>

        <!-- 球队实力 -->
        <div class="info-section">
          <h2>球队实力 (Elo)</h2>
          <div class="elo-row">
            <span id="elo-home-name">-</span>
            <span class="elo-score" id="elo-home-score">-</span>
            <span class="elo-vs">vs</span>
            <span class="elo-score" id="elo-away-score">-</span>
            <span id="elo-away-name">-</span>
          </div>
        </div>

        <!-- 最可能比分 -->
        <div class="info-section" id="scores-section" style="display:none">
          <h2>最可能比分分布</h2>
          <div class="scores-grid" id="scores-grid"></div>
        </div>

        <!-- 赔率对比区域 -->
        <div class="info-section" id="odds-section">
          <h2>市场赔率 <span class="api-source-badge api-source-live">Bet365</span></h2>
          <div id="odds-content">
            <div class="loading-sm">加载赔率数据...</div>
          </div>
        </div>

        <!-- ML 引擎额外信息 -->
        <div class="info-section" id="ml-info-section" style="display:none">
          <h2>ML 引擎详情 <span class="engine-badge" id="ml-version-badge">v1</span></h2>
          <div class="ml-grid">
            <!-- TOP 5 比分 -->
            <div class="ml-card" id="ml-top-scores">
              <div class="ml-card-title">最可能比分</div>
              <div class="ml-scores-list" id="ml-scores-list"></div>
            </div>
            <!-- 大小球 -->
            <div class="ml-card" id="ml-over-under">
              <div class="ml-card-title">大小球</div>
              <div class="ml-ou-grid" id="ml-ou-grid">
                <div class="ou-item"><span class="ou-label">O2.5</span><span class="ou-val" id="ou-25-over">-%</span></div>
                <div class="ou-item"><span class="ou-label">U2.5</span><span class="ou-val" id="ou-25-under">-%</span></div>
                <div class="ou-item"><span class="ou-label">O3.5</span><span class="ou-val" id="ou-35-over">-%</span></div>
                <div class="ou-item"><span class="ou-label">U3.5</span><span class="ou-val" id="ou-35-under">-%</span></div>
                <div class="ou-item ou-total"><span class="ou-label">预期总进球</span><span class="ou-val" id="ou-expected-total">-</span></div>
              </div>
            </div>
            <!-- BTTS -->
            <div class="ml-card" id="ml-btts">
              <div class="ml-card-title">双方进球 (BTTS)</div>
              <div class="btts-bars">
                <div class="btts-row"><span>是</span><div class="btts-track"><div class="btts-fill btts-yes" id="btts-yes-bar"></div></div><span class="btts-pct" id="btts-yes-pct">-%</span></div>
                <div class="btts-row"><span>否</span><div class="btts-track"><div class="btts-fill btts-no" id="btts-no-bar"></div></div><span class="btts-pct" id="btts-no-pct">-%</span></div>
              </div>
            </div>
            <!-- 风险评估 -->
            <div class="ml-card" id="ml-risk">
              <div class="ml-card-title">风险评估</div>
              <div class="risk-display">
                <span class="risk-badge" id="risk-level-badge">-</span>
                <span class="risk-score" id="risk-score-text">-</span>
                <p class="risk-desc" id="risk-description">-</p>
              </div>
            </div>
            <!-- 覆盖度 -->
            <div class="ml-card" id="ml-coverage">
              <div class="ml-card-title">覆盖度</div>
              <div class="cov-display">
                <span class="cov-pct" id="coverage-pct">-%</span>
                <span class="cov-label">TOP 3 比分覆盖</span>
                <span class="cov-pct cov-small" id="coverage-top3">-%</span>
              </div>
            </div>
            <!-- 模型元数据 -->
            <div class="ml-card ml-card-wide" id="ml-meta">
              <div class="ml-card-title">模型元数据</div>
              <div class="meta-grid">
                <div class="meta-item"><span class="meta-label">引擎</span><span class="meta-val" id="meta-engine">ml-v1</span></div>
                <div class="meta-item"><span class="meta-label">置信度</span><span class="meta-val" id="meta-confidence">-</span></div>
                <div class="meta-item"><span class="meta-label">特征数</span><span class="meta-val" id="meta-features">-</span></div>
                <div class="meta-item"><span class="meta-label">校准</span><span class="meta-val" id="meta-calibrated">-</span></div>
                <div class="meta-item"><span class="meta-label">集成权重</span><span class="meta-val" id="meta-ensemble-weights" style="display:none">-</span></div>
                <div class="meta-item"><span class="meta-label"></span><span class="meta-val" id="meta-weights-note" style="display:none"></span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 进度指示器 -->
        <div class="info-section" id="progress-section" style="display:none">
          <h2>比赛进度</h2>
          <div class="tournament-progress">
            <div class="progress-step" id="p-stage">小组赛</div>
            <div class="progress-arrow">→</div>
            <div class="progress-step" id="p-32">32强</div>
            <div class="progress-arrow">→</div>
            <div class="progress-step" id="p-16">16强</div>
            <div class="progress-arrow">→</div>
            <div class="progress-step" id="p-qf">8强</div>
            <div class="progress-arrow">→</div>
            <div class="progress-step" id="p-sf">4强</div>
            <div class="progress-arrow">→</div>
            <div class="progress-step" id="p-final">决赛</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: 市场分歧（客户端懒加载） -->
    <div id="tab-divergence" class="tab-content" data-lazy="/api/odds/fusion/match/<%= team1Slug %>/<%= team2Slug %>">
      <div class="lazy-placeholder">
        <div class="skeleton-line"></div>
        <div class="skeleton-line"></div>
        <div class="skeleton-line skeleton-line-short"></div>
        <p class="loading-text">加载市场分歧数据...</p>
      </div>
    </div>

    <!-- Tab: 数据详情（客户端懒加载） -->
    <div id="tab-data" class="tab-content" data-lazy="/api/matches/detail/<%= team1Slug %>/<%= team2Slug %>">
      <div class="lazy-placeholder">
        <div class="skeleton-line"></div>
        <div class="skeleton-line"></div>
        <div class="skeleton-line skeleton-line-short"></div>
        <p class="loading-text">加载数据详情...</p>
      </div>
    </div>

    <div id="error-message" class="empty-state" style="display:none">
      <p>⚠️ 未找到该场比赛信息</p>
      <a href="/" class="btn">← 返回首页</a>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
  const t1 = '<%= team1Slug %>';
  const t2 = '<%= team2Slug %>';
  // Phase 13: 服务端预渲染数据（首屏直接使用，跳过 fetch）
  const serverPred = <%- JSON.stringify(serverPrediction || null) %>;
  let currentEngine = 'elo';
  document.body.classList.add('page-match-detail');

  // ===== Phase 10 Task D: Tab 懒加载缓存 =====
  const lazyCache = {};

  // SVG 旗帜渲染
  function flagHtml(info, size) {
    size = size || 'sm';
    if (!info) return '<span class="team-flag flag-' + size + '"><span class="flag-fallback">⚽</span></span>';
    const svgPath = info.flagPath || '';
    const emoji = info.flag || '⚽';
    if (svgPath) {
      return '<span class="team-flag flag-' + size + '"><img src="' + svgPath + '" alt="' + (info.name || '') + '" loading="lazy" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'inline\'"><span class="flag-fallback" style="display:none">' + emoji + '</span></span>';
    }
    return '<span class="team-flag flag-' + size + '"><span class="flag-fallback">' + emoji + '</span></span>';
  }

  // Phase 13: 服务端预渲染 → 直接填充 DOM（首屏零延迟）
  function populateFromServerPred(sp) {
    document.getElementById('loading-spinner').style.display = 'none';
    document.getElementById('error-message').style.display = 'none';
    document.getElementById('prediction-detail').style.display = 'block';
    document.querySelectorAll('.engine-tab').forEach(t => t.classList.remove('active'));
    document.querySelector('.engine-tab[data-engine="elo"]').classList.add('active');

    document.getElementById('match-title').innerHTML =
      flagHtml({ flag: sp.homeFlag, flagPath: sp.homeFlagPath, name: sp.homeName }, 'md') + ' ' + sp.homeName + ' vs ' + sp.awayName + ' ' + flagHtml({ flag: sp.awayFlag, flagPath: sp.awayFlagPath, name: sp.awayName }, 'md');

    // 概率卡片
    document.getElementById('win-home-pct').textContent = sp.homeProb + '%';
    document.getElementById('draw-pct').textContent = sp.drawProb + '%';
    document.getElementById('win-away-pct').textContent = sp.awayProb + '%';

    // xG
    document.getElementById('xg-home-name').textContent = sp.homeName;
    document.getElementById('xg-away-name').textContent = sp.awayName;
    document.getElementById('xg-home-val').textContent = sp.xgHome;
    document.getElementById('xg-away-val').textContent = sp.xgAway;
    const maxXg = Math.max(sp.xgHome, sp.xgAway, 1.5);
    document.getElementById('xg-home-bar').style.width = (sp.xgHome / maxXg * 100) + '%';
    document.getElementById('xg-away-bar').style.width = (sp.xgAway / maxXg * 100) + '%';

    // Elo
    document.getElementById('elo-home-name').textContent = sp.homeName;
    document.getElementById('elo-away-name').textContent = sp.awayName;
    document.getElementById('elo-home-score').textContent = sp.homeElo;
    document.getElementById('elo-away-score').textContent = sp.awayElo;

    // Top 比分
    if (sp.topScores && sp.topScores.length > 0) {
      document.getElementById('scores-section').style.display = 'block';
      var grid = document.getElementById('scores-grid');
      grid.innerHTML = '';
      sp.topScores.forEach(function(s) {
        var sc = document.createElement('div');
        sc.className = 'score-chip';
        sc.innerHTML = '<span class="score-result">' + s.home + ':' + s.away + '</span><span class="score-prob">' + s.prob + '%</span>';
        grid.appendChild(sc);
      });
    }

    // 风险评估
    if (sp.riskLevel) {
      var badge = document.getElementById('risk-level-badge');
      var riskText = sp.riskLevel === 'low' ? '低风险' : sp.riskLevel === 'medium' ? '中风险' : '高风险';
      badge.textContent = riskText;
      badge.className = 'risk-badge risk-' + sp.riskLevel;
    }

    // 清除降级提示
    var degBanner = document.getElementById('degraded-banner');
    if (degBanner) degBanner.style.display = 'none';

    currentEngine = 'elo';
  }

  // Phase 13: 异步加载次要数据（赔率、比赛信息）— 不阻塞首屏
  var _secLoaded = false;
  async function loadSecondaryData(force) {
    if (_secLoaded && !force) return;
    _secLoaded = true;
    try {
      // 比赛信息
      var matchInfo = await cachedFetch('/api/matches/match/' + t1 + '/' + t2 + '?engine=elo', { force: false }).catch(function() { return null; });
      if (matchInfo && matchInfo.match) {
        var match = matchInfo.match;
        document.getElementById('match-info-bar').style.display = 'block';
        var stageLabels = { 'GROUP_STAGE':'小组赛','LAST_32':'32强','LAST_16':'16强','QUARTER_FINALS':'8强','SEMI_FINALS':'4强','FINAL':'决赛','THIRD_PLACE':'季军赛' };
        document.getElementById('mi-stage').textContent = stageLabels[match.stage] || match.stage || '-';
        document.getElementById('mi-group').textContent = match.group ? match.group + '组' : '-';
        document.getElementById('mi-matchday').textContent = match.matchday ? '第' + match.matchday + '轮' : (match.stage && match.stage !== 'GROUP_STAGE' ? stageLabels[match.stage] || '' : '-');
        if (match.utcDate) {
          var d = new Date(match.utcDate);
          var bj = new Date(d.getTime() + 8 * 3600000);
          var pad = function(n) { return String(n).padStart(2, '0'); };
          document.getElementById('mi-time').textContent = bj.getUTCFullYear() + '-' + pad(bj.getUTCMonth()+1) + '-' + pad(bj.getUTCDate()) + ' ' + pad(bj.getUTCHours()) + ':' + pad(bj.getUTCMinutes());
        }
        document.getElementById('mi-status').textContent = match.status === 'FT' ? '已完赛' : match.status === 'TIMED' ? '未开赛' : match.status;
        document.getElementById('mi-score').textContent = (match.g1 != null) ? match.g1 + ' : ' + match.g2 : '-';
        document.getElementById('progress-section').style.display = 'block';
        var stageOrder = ['GROUP_STAGE','LAST_32','LAST_16','QUARTER_FINALS','SEMI_FINALS','FINAL'];
        var currentIdx = stageOrder.indexOf(match.stage);
        document.querySelectorAll('.progress-step').forEach(function(el, i) {
          if (i < currentIdx) el.classList.add('completed');
          else if (i === currentIdx) el.classList.add('current');
          else el.classList.add('upcoming');
        });
      }

      // 赔率（静默加载）
      var oddsData = await cachedFetch('/api/odds/match/' + t1 + '/' + t2, { force: false }).catch(function() { return null; });
      if (oddsData && oddsData.found && oddsData.bookmakers) {
        renderOddsTable(oddsData, document.getElementById('odds-content'));
      }
    } catch (e) {
      // 静默失败，不影响首屏
    }
  }

  async function loadMatchData(force, engine) {
    engine = engine || currentEngine;

    // Phase 13: 服务端预渲染 → 首屏直接使用 Elo 数据，跳过 fetch
    if (serverPred && engine === 'elo' && !force) {
      populateFromServerPred(serverPred);
      // 仅异步加载次要数据（赔率、比赛信息）
      loadSecondaryData(force);
      return;
    }

    if (force) {
      document.getElementById('loading-spinner').style.display = 'block';
    }
    // Clear content before re-rendering on refresh
    document.getElementById('prediction-detail').style.display = 'none';
    document.getElementById('error-message').style.display = 'none';
    document.getElementById('scores-grid').innerHTML = '';
    document.getElementById('ml-info-section').style.display = 'none';
    document.getElementById('odds-content').innerHTML = '<div class="loading-sm">加载赔率数据...</div>';

    try {
      const feed = await Promise.all([
        cachedFetch(`/api/matches/match/${t1}/${t2}?engine=${engine}`, { force }),
        cachedFetch(`/api/matches/compare/${t1}/${t2}?scores=true`, { force }).catch(function() { return {}; }),
      ]);
      var matchData = feed[0], compareData = feed[1] || {};

      document.getElementById('loading-spinner').style.display = 'none';

      // 后端返回了错误对象而非预测数据
      if (!matchData || !matchData.prediction) {
        document.getElementById('error-message').querySelector('p').textContent = matchData && matchData.error ? '⚠️ ' + matchData.error : '⚠️ 未找到该场比赛信息';
        document.getElementById('error-message').style.display = 'block';
        console.error('预测数据返回异常:', matchData);
        return;
      }
      const pred = matchData.prediction;
      const match = matchData.match;

      // 更新引擎选择器
      document.querySelectorAll('.engine-tab').forEach(t => t.classList.remove('active'));
      document.querySelector(`.engine-tab[data-engine="${engine}"]`).classList.add('active');
      currentEngine = engine;

      // Phase 6.1: 后端已统一概率协议，始终从 probabilities 读取
      const homeName = pred.home ? pred.home.name : pred.homeTeam;
      const awayName = pred.away ? pred.away.name : pred.awayTeam;
      const homeFlag = pred.home ? (pred.home.flag || '⚽') : '⚽';
      const awayFlag = pred.away ? (pred.away.flag || '⚽') : '⚽';
      const homeProb = (pred.probabilities.homeWin * 100).toFixed(1);
      const drawProb = (pred.probabilities.draw * 100).toFixed(1);
      const awayProb = (pred.probabilities.awayWin * 100).toFixed(1);
      const xgHome = pred.expectedGoals.home;
      const xgAway = pred.expectedGoals.away;

      document.getElementById('match-title').innerHTML =
        flagHtml(pred.home, 'md') + ' ' + homeName + ' vs ' + awayName + ' ' + flagHtml(pred.away, 'md');

      document.getElementById('prediction-detail').style.display = 'block';

      // 降级提示
      if (pred._degraded) {
        var degBanner = document.getElementById('degraded-banner');
        if (!degBanner) {
          degBanner = document.createElement('div');
          degBanner.id = 'degraded-banner';
          degBanner.className = 'degrade-banner';
          degBanner.style.marginBottom = '12px';
          document.getElementById('prediction-detail').insertBefore(degBanner, document.getElementById('prediction-detail').firstChild);
        }
        degBanner.innerHTML = '⚠️ ML 模型暂时不可用，已降级到 Elo 引擎提供基础预测';
        degBanner.style.display = 'block';
      } else {
        var degBanner = document.getElementById('degraded-banner');
        if (degBanner) degBanner.style.display = 'none';
      }

      // 概率
      document.getElementById('win-home-pct').textContent = homeProb + '%';
      document.getElementById('draw-pct').textContent = drawProb + '%';
      document.getElementById('win-away-pct').textContent = awayProb + '%';

      // xG
      document.getElementById('xg-home-name').innerHTML = flagHtml(pred.home, 'sm') + ' ' + homeName;
      document.getElementById('xg-away-name').innerHTML = flagHtml(pred.away, 'sm') + ' ' + awayName;
      document.getElementById('xg-home-val').textContent = xgHome;
      document.getElementById('xg-away-val').textContent = xgAway;
      const maxXg = Math.max(xgHome, xgAway, 1.5);
      document.getElementById('xg-home-bar').style.width = (xgHome / maxXg * 100) + '%';
      document.getElementById('xg-away-bar').style.width = (xgAway / maxXg * 100) + '%';

      // Elo 或 Elo 等效
      if (pred.home && pred.home.elo) {
        document.getElementById('elo-home-name').innerHTML = flagHtml(pred.home, 'sm') + ' ' + homeName;
        document.getElementById('elo-away-name').innerHTML = flagHtml(pred.away, 'sm') + ' ' + awayName;
        document.getElementById('elo-home-score').textContent = pred.home.elo;
        document.getElementById('elo-away-score').textContent = pred.away.elo;
      } else {
        var eloRow = document.querySelector('.info-section .elo-row');
        if (eloRow) eloRow.closest('.info-section').style.display = 'none';
      }

      // 比赛信息
      if (match) {
        document.getElementById('match-info-bar').style.display = 'block';
        const stageLabels = {
          'GROUP_STAGE':'小组赛','LAST_32':'32强','LAST_16':'16强',
          'QUARTER_FINALS':'8强','SEMI_FINALS':'4强','FINAL':'决赛','THIRD_PLACE':'季军赛'
        };
        document.getElementById('mi-stage').textContent = stageLabels[match.stage] || match.stage || '-';
        document.getElementById('mi-group').textContent = match.group ? match.group + '组' : '-';
        document.getElementById('mi-matchday').textContent = match.matchday
          ? '第' + match.matchday + '轮'
          : (match.stage && match.stage !== 'GROUP_STAGE' ? stageLabels[match.stage] || '' : '-');
        // 开球时间从 UTC 转为北京时间 (CST, UTC+8)
        let beijingTime = '-';
        if (match.utcDate) {
          const d = new Date(match.utcDate);
          const bj = new Date(d.getTime() + 8 * 3600000);
          const pad = n => String(n).padStart(2, '0');
          beijingTime = `${bj.getUTCFullYear()}-${pad(bj.getUTCMonth()+1)}-${pad(bj.getUTCDate())} ${pad(bj.getUTCHours())}:${pad(bj.getUTCMinutes())}`;
        } else if (match.date) {
          beijingTime = match.date + ' ' + (match.time || '');
        }
        document.getElementById('mi-time').textContent = beijingTime;
        document.getElementById('mi-status').textContent = match.status === 'FT' ? '已完赛' : match.status === 'TIMED' ? '未开赛' : match.status;
        document.getElementById('mi-score').textContent = (match.g1 != null) ? match.g1 + ' : ' + match.g2 : '-';

        // Phase 8.1: 淘汰赛加时/点球分解
        if (match.stage && match.stage !== 'GROUP_STAGE') {
          fetchKnockoutPrediction(t1, t2, match.stage);
        }

        document.getElementById('progress-section').style.display = 'block';
        const stageOrder = ['GROUP_STAGE','LAST_32','LAST_16','QUARTER_FINALS','SEMI_FINALS','FINAL'];
        const currentIdx = stageOrder.indexOf(match.stage);
        document.querySelectorAll('.progress-step').forEach((el, i) => {
          if (i < currentIdx) el.classList.add('completed');
          else if (i === currentIdx) el.classList.add('current');
          else el.classList.add('upcoming');
        });
      }

      // 比分分布（按引擎区分：ML/Ensemble 用预测的 topScores，Elo 用 compareData）
      var isEl = (engine === 'elo');
      var scoresData = isEl ? (compareData.topScores || []) : (pred.topScores || []);
      if (scoresData.length > 0) {
        document.getElementById('scores-section').style.display = 'block';
        var grid = document.getElementById('scores-grid');
        grid.innerHTML = '';
        scoresData.slice(0, 3).forEach(function(s) {
          var sc = document.createElement('div');
          sc.className = 'score-chip';
          if (isEl) {
            sc.innerHTML = '<span class="score-result">' + s.home + ':' + s.away + '</span><span class="score-prob">' + s.prob + '%</span>';
          } else {
            var pct = ((s.probability != null ? s.probability : s.prob / 100 || 0) * 100).toFixed(1);
            sc.innerHTML = '<span class="score-result">' + s.home + ':' + s.away + '</span><span class="score-prob">' + pct + '%</span>';
          }
          grid.appendChild(sc);
        });
      }

      // 赔率
      const oddsData = await cachedFetch(`/api/odds/match/${t1}/${t2}`, { force });
      const oc = document.getElementById('odds-content');
      if (!oddsData.found || !oddsData.bookmakers) {
        oc.innerHTML = '<p class="text-muted">暂未获取到市场赔率</p>';
      } else {
        renderOddsTable(oddsData, oc);
      }

      // ---------- ML 引擎额外信息 ----------
      if (pred.engine && pred.engine !== 'elo') {
        document.getElementById('ml-info-section').style.display = 'block';
        document.getElementById('ml-version-badge').textContent = pred.engineVersion || 'v1';

        // TOP 5 比分（来自 ML 的 topScores 结构）
        const topScores = pred.topScores || [];
        const scoresList = document.getElementById('ml-scores-list');
        scoresList.innerHTML = '';
        topScores.slice(0, 3).forEach(s => {
          const div = document.createElement('div');
          div.className = 'ml-score-row';
          div.innerHTML = `<span class="ml-score-result">${s.home} : ${s.away}</span><span class="ml-score-prob-bar"><span class="ml-score-bar" style="width:${(s.probability * 1000)}%"></span></span><span class="ml-score-prob">${(s.probability * 100).toFixed(1)}%</span>`;
          scoresList.appendChild(div);
        });

        // 大小球
        if (pred.overUnder) {
          document.getElementById('ou-25-over').textContent = (pred.overUnder.over2_5 * 100).toFixed(1) + '%';
          document.getElementById('ou-25-under').textContent = (pred.overUnder.under2_5 * 100).toFixed(1) + '%';
          document.getElementById('ou-35-over').textContent = (pred.overUnder.over3_5 * 100).toFixed(1) + '%';
          document.getElementById('ou-35-under').textContent = (pred.overUnder.under3_5 * 100).toFixed(1) + '%';
          document.getElementById('ou-expected-total').textContent = pred.overUnder.expectedTotal;
        }

        // BTTS
        if (pred.btts) {
          const bttsYes = pred.btts.yes * 100;
          const bttsNo = pred.btts.no * 100;
          document.getElementById('btts-yes-pct').textContent = bttsYes.toFixed(1) + '%';
          document.getElementById('btts-no-pct').textContent = bttsNo.toFixed(1) + '%';
          document.getElementById('btts-yes-bar').style.width = bttsYes + '%';
          document.getElementById('btts-no-bar').style.width = bttsNo + '%';
        }

        // 风险评估
        if (pred.risk) {
          const badge = document.getElementById('risk-level-badge');
          badge.textContent = pred.risk.level === 'low' ? '低风险' : pred.risk.level === 'medium' ? '中风险' : '高风险';
          badge.className = 'risk-badge risk-' + pred.risk.level;
          document.getElementById('risk-score-text').textContent = '评分: ' + pred.risk.score;
          document.getElementById('risk-description').textContent = pred.risk.description;
        }

        // 覆盖度
        if (pred.coverage) {
          document.getElementById('coverage-pct').textContent = pred.coverage.percent + '%';
          document.getElementById('coverage-top3').textContent = pred.coverage.top3ScoreCoverage + '%';
        }

        // 模型元数据
        if (pred.metadata) {
          document.getElementById('meta-engine').textContent = pred.engine || 'ml';
          document.getElementById('meta-confidence').textContent = pred.metadata.confidence ? (pred.metadata.confidence * 100).toFixed(1) + '%' : '-';
          document.getElementById('meta-features').textContent = pred.metadata.features ? pred.metadata.features.length : '-';
          document.getElementById('meta-calibrated').textContent = pred.metadata.calibrated ? '是' : '否';
        }
        // Phase 6.5a: 权重显示
        if (pred.metadata && pred.metadata.ensembleWeights) {
          var ew = pred.metadata.ensembleWeights;
          var ewText = '';
          if (ew.elo != null) ewText += 'Elo ' + (ew.elo * 100).toFixed(0) + '%';
          if (ew.ml != null) ewText += (ewText ? ' / ' : '') + 'ML ' + (ew.ml * 100).toFixed(0) + '%';
          document.getElementById('meta-ensemble-weights').textContent = ewText;
          document.getElementById('meta-ensemble-weights').style.display = 'block';
          if (pred.metadata.dynamicAdjusted) {
            document.getElementById('meta-weights-note').textContent = '· 动态调整';
            document.getElementById('meta-weights-note').style.display = 'inline';
          }
        }
      }

    } catch (err) {
      document.getElementById('loading-spinner').style.display = 'none';
      document.getElementById('error-message').style.display = 'block';
      console.error('加载数据失败:', err);
    }
  }

  // 赔率表格渲染
  function renderOddsTable(oddsData, oc) {
    oc.innerHTML = '';
    const table = document.createElement('div');
    table.className = 'odds-table';
    const thead = document.createElement('div');
    thead.className = 'odds-row odds-header';
    thead.innerHTML = '<span class="odds-bm">博彩公司</span><span class="odds-val odds-h">主胜</span><span class="odds-val odds-d">平局</span><span class="odds-val odds-a">客胜</span>';
    table.appendChild(thead);
    for (const [bm, o] of Object.entries(oddsData.bookmakers)) {
      const row = document.createElement('div');
      row.className = 'odds-row';
      row.innerHTML = `<span class="odds-bm">${bm}</span><span class="odds-val odds-h">${o.home.toFixed(3)}</span><span class="odds-val odds-d">${o.draw.toFixed(3)}</span><span class="odds-val odds-a">${o.away.toFixed(3)}</span>`;
      table.appendChild(row);
    }
    const b = oddsData.best;
    const totalImplied = 1/b.home + 1/b.draw + 1/b.away;
    const fairRow = document.createElement('div');
    fairRow.className = 'odds-row odds-fair';
    fairRow.innerHTML = `<span class="odds-bm">公平概率</span><span class="odds-val odds-h">${(1/b.home / totalImplied * 100).toFixed(1)}%</span><span class="odds-val odds-d">${(1/b.draw / totalImplied * 100).toFixed(1)}%</span><span class="odds-val odds-a">${(1/b.away / totalImplied * 100).toFixed(1)}%</span>`;
    table.appendChild(fairRow);
    oc.appendChild(table);
  }

  // ===== Phase 10 Task D: Tab 切换 =====
  function switchTab(tabId) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelector('.tab-btn[data-tab="' + tabId + '"]').classList.add('active');
    document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
    const tabContent = document.getElementById('tab-' + tabId);
    tabContent.classList.add('active');

    // 懒加载（分歧Tab和数据Tab）
    const lazyUrl = tabContent.getAttribute('data-lazy');
    if (lazyUrl && !tabContent.dataset.loaded) {
      const ck = currentEngine + ':' + tabId;
      if (lazyCache[ck]) {
        tabContent.innerHTML = lazyCache[ck];
        tabContent.dataset.loaded = '1';
        return;
      }
      loadLazyTab(tabContent, lazyUrl, tabId);
    }
  }

  async function loadLazyTab(container, url, tabId) {
    const ck = currentEngine + ':' + tabId;
    container.innerHTML = '<div class="lazy-placeholder"><div class="skeleton-line"></div><div class="skeleton-line"></div><div class="skeleton-line skeleton-line-short"></div><p class="loading-text">加载中...</p></div>';
    try {
      const sep = url.includes('?') ? '&' : '?';
      const r = await fetch(url + sep + 'engine=' + currentEngine + '&_t=' + Date.now());
      if (!r.ok) {
        container.innerHTML = '<div class="lazy-error"><p>⚠️ 服务暂时不可用</p><p class="lazy-error-detail">HTTP ' + r.status + ' - API 限流或超时，请稍后重试</p><button class="btn btn-sm" onclick="switchTab(\'' + tabId + '\')">重试</button></div>';
        return;
      }
      const data = await r.json();
      if (data.error) {
        container.innerHTML = '<div class="lazy-error"><p>⚠️ ' + data.error + '</p><p class="lazy-error-detail">数据暂时不可用，请稍后重试或切换引擎</p><button class="btn btn-sm" onclick="switchTab(\'' + tabId + '\')">重试</button></div>';
        return;
      }
      let html;
      if (tabId === 'divergence') html = renderDivergenceContent(data);
      else html = renderDataContent(data);
      container.innerHTML = html;
      container.dataset.loaded = '1';
      lazyCache[ck] = html;
    } catch (e) {
      container.innerHTML = '<div class="lazy-error"><p>⚠️ 数据加载失败</p><p class="lazy-error-detail">' + e.message + '</p><button class="btn btn-sm" onclick="switchTab(\'' + tabId + '\')">重试</button></div>';
    }
  }

  // ===== 市场分歧 Tab 渲染 =====
  function renderDivergenceContent(data) {
    var s = data.sources || [];
    var model = data.model;
    var f = data.fusion;
    var html = '<div class="fusion-panel"><h3>信源对比</h3><div class="fusion-compare">';

    // 标题行
    html += '<div class="fusion-row fusion-header"><span class="fusion-label">信源</span><span class="fusion-p">主胜</span><span class="fusion-p">平局</span><span class="fusion-p">客胜</span></div>';

    // 四信源：市场(去抽水) + Polymarket + 模型 + 竞彩网
    var allSources = [
      { label: '市场 (去抽水)', src: s.find(function(si) { return si.source === 'oddsApi'; }) },
      { label: 'Polymarket', src: s.find(function(si) { return si.source === 'polymarket'; }) },
      { label: '模型', src: model },
      { label: '竞彩网', src: s.find(function(si) { return si.source === 'china-sports-lottery'; }) },
    ];

    allSources.forEach(function(si) {
      if (!si.src || !si.src.probabilities) return;
      var p = si.src.probabilities;
      html += '<div class="fusion-row"><span class="fusion-label">' + si.label + '</span><span class="fusion-p">' + (p.homeWin * 100).toFixed(1) + '%</span><span class="fusion-p">' + (p.draw * 100).toFixed(1) + '%</span><span class="fusion-p">' + (p.awayWin * 100).toFixed(1) + '%</span></div>';
    });

    // 融合结果（高亮）
    if (f && f.fused) {
      html += '<div class="fusion-row fusion-result"><span class="fusion-label">🔬 融合</span><span class="fusion-p">' + (f.fused.homeWin * 100).toFixed(1) + '%</span><span class="fusion-p">' + (f.fused.draw * 100).toFixed(1) + '%</span><span class="fusion-p">' + (f.fused.awayWin * 100).toFixed(1) + '%</span></div>';
    }
    html += '</div>';

    // 元数据
    html += '<div class="fusion-meta">';
    if (f && f.weights) {
      html += '<span>权重: ' + Object.entries(f.weights).filter(function(kv) { return kv[1] > 0; }).map(function(kv) { return kv[0] + ' ' + (kv[1] * 100).toFixed(0) + '%'; }).join(' | ') + '</span>';
    }
    if (f && f.divergence) {
      var c = f.divergence.level === 'high' ? '#ef4444' : f.divergence.level === 'medium' ? '#eab308' : '#22c55e';
      html += '<span>分歧: <span style="color:' + c + '">' + (f.divergence.maxDivergence * 100).toFixed(1) + '%</span> (' + f.divergence.level + ')</span>';
    }
    html += '<span>置信度: ' + (f ? (f.confidence * 100).toFixed(0) : '-') + '%</span>';
    if (f) html += '<span>策略: ' + f.strategy + '</span>';
    if (f) html += '<span>源数: ' + f.nSources + '</span>';

    // 细分分歧（带颜色）
    if (data.marketDivergence) {
      var d = data.marketDivergence;
      function divColor(val) {
        var pct = val * 100;
        if (pct < 5) return '#22c55e';
        if (pct < 10) return '#eab308';
        return '#ef4444';
      }
      function divLabel(val) {
        var pct = val * 100;
        if (pct < 5) return '低分歧';
        if (pct < 10) return '中分歧';
        return '高分歧';
      }
      html += '</div><h3>市场分歧指标</h3>';
      html += '<div class="div-grid"><div>主胜差 <span class="div-val" style="color:' + divColor(d.maxMinSpread.home) + '">' + (d.maxMinSpread.home * 100).toFixed(1) + '%</span> <span class="div-badge" style="background:' + divColor(d.maxMinSpread.home) + '20;color:' + divColor(d.maxMinSpread.home) + ';border:1px solid ' + divColor(d.maxMinSpread.home) + '40">' + divLabel(d.maxMinSpread.home) + '</span></div>';
      html += '<div>平局差 <span class="div-val" style="color:' + divColor(d.maxMinSpread.draw) + '">' + (d.maxMinSpread.draw * 100).toFixed(1) + '%</span> <span class="div-badge" style="background:' + divColor(d.maxMinSpread.draw) + '20;color:' + divColor(d.maxMinSpread.draw) + ';border:1px solid ' + divColor(d.maxMinSpread.draw) + '40">' + divLabel(d.maxMinSpread.draw) + '</span></div>';
      html += '<div>客胜差 <span class="div-val" style="color:' + divColor(d.maxMinSpread.away) + '">' + (d.maxMinSpread.away * 100).toFixed(1) + '%</span> <span class="div-badge" style="background:' + divColor(d.maxMinSpread.away) + '20;color:' + divColor(d.maxMinSpread.away) + ';border:1px solid ' + divColor(d.maxMinSpread.away) + '40">' + divLabel(d.maxMinSpread.away) + '</span></div>';
      html += '<div>源数 <span class="div-val">' + d.nSources + '</span></div></div>';
    }

    // 博彩公司明细
    if (data.bookmakerDetails && data.bookmakerDetails.length > 0) {
      html += '<h3>博彩公司明细</h3><div class="odds-table">';
      html += '<div class="odds-row odds-header"><span class="odds-bm">公司</span><span class="odds-val odds-h">主</span><span class="odds-val odds-d">平</span><span class="odds-val odds-a">客</span><span class="odds-val odds-m">Margin</span></div>';
      data.bookmakerDetails.forEach(function(bm) {
        html += '<div class="odds-row"><span class="odds-bm">' + bm.name + '</span><span class="odds-val odds-h">' + bm.odds.home.toFixed(2) + '</span><span class="odds-val odds-d">' + bm.odds.draw.toFixed(2) + '</span><span class="odds-val odds-a">' + bm.odds.away.toFixed(2) + '</span><span class="odds-val odds-m">' + (bm.margin ? (bm.margin * 100).toFixed(1) + '%' : '-') + '</span></div>';
      });
      html += '</div>';
    }

    if (data.degraded) html += '<div class="degrade-banner">⚠️ 可用赔率源不足，部分数据降级</div>';
    html += '</div>';
    return html;
  }

  // ===== 数据详情 Tab 渲染 =====
  function renderDataContent(data) {
    var html = '<div class="data-detail-panel">';

    // 空数据兜底
    if (!data.expectedGoals && !data.overUnder && !data.btts && !data.topScores) {
      html += '<div class="empty-state" style="margin-top:20px;"><p>预测详情数据生成中，请稍后重试或切换引擎</p>';
      html += '<button class="btn" onclick="switchTab(\'data\')">重试</button></div>';
      html += '</div>';
      return html;
    }

    // 引擎和版本徽标
    var engBadge = data.engine || '-';
    var engVer = data.engineVersion || '';
    if (engVer) {
      if (engVer.indexOf('v') === 0 || engVer.indexOf('V') === 0) engBadge += ' ' + engVer;
      else engBadge += ' v' + engVer;
    }
    html += '<div class="engine-info-bar" style="display:flex;gap:10px;align-items:center;margin-bottom:14px;padding:10px 14px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">';
    html += '<span style="font-size:0.78rem;color:var(--text-muted)">当前引擎</span>';
    html += '<span class="engine-badge">' + engBadge + '</span>';
    if (data.metadata && data.metadata.directionGate) {
      var dg = data.metadata.directionGate;
      var dirLabel = dg.mainDirection === 'home' ? '主胜' : dg.mainDirection === 'draw' ? '平局' : '客胜';
      html += '<span style="font-size:0.78rem;color:var(--text-muted)">方向门控</span>';
      html += '<span class="risk-badge risk-' + (dg.mainDirection === 'home' ? 'low' : dg.mainDirection === 'draw' ? 'medium' : 'high') + '" style="font-size:0.72rem;padding:2px 8px;">' + dirLabel + (dg.gated ? ' ✓' : ' ✗') + '</span>';
    }
    html += '</div>';

    // 最可能比分（补全）
    if (data.topScores && data.topScores.length > 0) {
      html += '<div class="info-section"><h2>最可能比分</h2>';
      var maxProb = data.topScores[0].probability != null ? data.topScores[0].probability : (data.topScores[0].prob / 100 || 0.01);
      data.topScores.slice(0, 5).forEach(function(s) {
        var prob = s.probability != null ? s.probability : (s.prob / 100 || 0);
        var pct = (prob * 100).toFixed(1);
        var barW = Math.max((prob / maxProb * 100), 5);
        html += '<div class="data-score-item">';
        html += '<span class="score-result">' + s.home + ':' + s.away + '</span>';
        html += '<div class="ml-score-prob-bar"><div class="ml-score-bar" style="width:' + barW + '%"></div></div>';
        html += '<span class="score-prob">' + pct + '%</span>';
        html += '</div>';
      });
      html += '</div>';
    }

    // 预期进球 λ
    if (data.expectedGoals) {
      var maxXg = Math.max(data.expectedGoals.home, data.expectedGoals.away, 1.5);
      html += '<div class="info-section"><h2>预期进球 λ</h2>';
      html += '<div class="xg-row"><span class="xg-team" style="min-width:70px;">' + (data.homeTeam || '主队') + '</span><div class="xg-track"><div class="xg-fill xg-home-fill" style="width:' + (data.expectedGoals.home / maxXg * 100) + '%"></div></div><span class="xg-value" style="min-width:36px;text-align:right;">' + data.expectedGoals.home.toFixed(2) + '</span></div>';
      html += '<div class="xg-row"><span class="xg-team" style="min-width:70px;">' + (data.awayTeam || '客队') + '</span><div class="xg-track"><div class="xg-fill xg-away-fill" style="width:' + (data.expectedGoals.away / maxXg * 100) + '%"></div></div><span class="xg-value" style="min-width:36px;text-align:right;">' + data.expectedGoals.away.toFixed(2) + '</span></div>';
      html += '</div>';
    }

    // 大小球
    if (data.overUnder) {
      html += '<div class="info-section"><h2>大小球</h2><div class="ml-ou-grid">';
      var ou = data.overUnder;
      html += '<div class="ou-item"><span class="ou-label">O2.5</span><span class="ou-val">' + (ou.over2_5 * 100).toFixed(1) + '%</span></div>';
      html += '<div class="ou-item"><span class="ou-label">U2.5</span><span class="ou-val">' + (ou.under2_5 * 100).toFixed(1) + '%</span></div>';
      html += '<div class="ou-item"><span class="ou-label">O3.5</span><span class="ou-val">' + (ou.over3_5 * 100).toFixed(1) + '%</span></div>';
      html += '<div class="ou-item"><span class="ou-label">U3.5</span><span class="ou-val">' + (ou.under3_5 * 100).toFixed(1) + '%</span></div>';
      html += '<div class="ou-item ou-total"><span class="ou-label">预期总进球</span><span class="ou-val" style="font-size:1rem;">' + ou.expectedTotal + '</span></div>';
      html += '</div></div>';
    }

    // 双方进球 (BTTS)
    if (data.btts) {
      html += '<div class="info-section"><h2>双方进球 (BTTS)</h2><div class="btts-bars">';
      var by = (data.btts.yes * 100).toFixed(1);
      var bn = (data.btts.no * 100).toFixed(1);
      html += '<div class="btts-row"><span>是</span><div class="btts-track"><div class="btts-fill btts-yes" style="width:' + by + '%"></div></div><span class="btts-pct">' + by + '%</span></div>';
      html += '<div class="btts-row"><span>否</span><div class="btts-track"><div class="btts-fill btts-no" style="width:' + bn + '%"></div></div><span class="btts-pct">' + bn + '%</span></div>';
      html += '</div></div>';
    }

    // 风险评估
    if (data.risk) {
      var rl = data.risk.level === 'low' ? '低风险' : data.risk.level === 'medium' ? '中风险' : '高风险';
      html += '<div class="info-section"><h2>风险评估</h2><div class="risk-display"><span class="risk-badge risk-' + data.risk.level + '" style="font-size:0.82rem;padding:4px 12px;">' + rl + '</span>';
      if (data.risk.score != null) html += '<span class="risk-score" style="margin-left:10px;">评分: <strong>' + data.risk.score + '</strong></span>';
      if (data.risk.description) html += '<p class="risk-desc" style="margin-top:6px;color:var(--text-muted);font-size:0.82rem;">' + data.risk.description + '</p>';
      html += '</div></div>';
    }

    // 引擎信息 + 覆盖度 + 元数据
    html += '<div class="info-section"><h2>引擎信息</h2><div class="meta-grid">';
    html += '<div class="meta-item"><span class="meta-label">引擎</span><span class="meta-val">' + (data.engine || '-') + '</span></div>';
    html += '<div class="meta-item"><span class="meta-label">版本</span><span class="meta-val">' + (data.engineVersion || '-') + '</span></div>';
    if (data.metadata && data.metadata.confidence != null) {
      html += '<div class="meta-item"><span class="meta-label">置信度</span><span class="meta-val">' + (data.metadata.confidence * 100).toFixed(1) + '%</span></div>';
    }
    if (data.metadata && data.metadata.features) {
      html += '<div class="meta-item"><span class="meta-label">特征维度</span><span class="meta-val">' + (data.metadata.features.length || data.metadata.features) + '</span></div>';
    }
    if (data.metadata && data.metadata.calibrated != null) {
      html += '<div class="meta-item"><span class="meta-label">概率校准</span><span class="meta-val">' + (data.metadata.calibrated ? '✓ 已校准' : '未校准') + '</span></div>';
    }
    if (data.coverage) {
      html += '<div class="meta-item"><span class="meta-label">总覆盖</span><span class="meta-val">' + data.coverage.percent + '%</span></div>';
      if (data.coverage.top3ScoreCoverage != null) html += '<div class="meta-item"><span class="meta-label">TOP3覆盖</span><span class="meta-val">' + data.coverage.top3ScoreCoverage + '%</span></div>';
    }
    // ensemble 权重（如果有）
    if (data.metadata && data.metadata.ensembleWeights) {
      var ew = data.metadata.ensembleWeights;
      var ewTxt = '';
      if (ew.elo != null) ewTxt += 'Elo ' + (ew.elo * 100).toFixed(0) + '%';
      if (ew.ml != null) ewTxt += (ewTxt ? ' / ' : '') + 'ML ' + (ew.ml * 100).toFixed(0) + '%';
      if (ewTxt) html += '<div class="meta-item"><span class="meta-label">集成权重</span><span class="meta-val">' + ewTxt + '</span></div>';
    }
    html += '</div></div>';

    html += '</div>';
    return html;
  }

  // Phase 8.1: 淘汰赛加时/点球分解
  async function fetchKnockoutPrediction(t1, t2, stage) {
    try {
      const stageMap = {
        'LAST_32':'round32','LAST_16':'round16',
        'QUARTER_FINALS':'quarter','SEMI_FINALS':'semi','FINAL':'final'
      };
      const s = stageMap[stage] || 'round32';
      const r = await fetch(`/api/matches/knockout-pred/${t1}/${t2}?stage=${s}`);
      if (!r.ok) return;
      const kp = await r.json();
      document.getElementById('knockout-breakdown').style.display = 'block';
      document.getElementById('kb-reg').textContent = ((kp.regWinA + kp.regWinB) * 100).toFixed(1) + '%';
      document.getElementById('kb-et').textContent = ((kp.etWinA + kp.etWinB) * 100).toFixed(1) + '%';
      document.getElementById('kb-pk').textContent = ((kp.pkWinA + kp.pkWinB) * 100).toFixed(1) + '%';
    } catch (e) {
      console.warn('淘汰赛数据加载失败:', e.message);
    }
  }

  // 引擎切换：清除懒加载缓存，重新加载全部数据
  function switchEngine(engine) {
    if (engine === currentEngine) return;
    // 清除旧引擎的懒加载缓存
    Object.keys(lazyCache).forEach(function(k) {
      if (k.indexOf(currentEngine + ':') === 0) delete lazyCache[k];
    });
    // 清除懒加载 Tab 的 loaded 标记和内容（重新显示骨架）
    document.querySelectorAll('.tab-content[data-lazy]').forEach(function(tc) {
      delete tc.dataset.loaded;
      tc.innerHTML = '<div class="lazy-placeholder"><div class="skeleton-line"></div><div class="skeleton-line"></div><div class="skeleton-line skeleton-line-short"></div><p class="loading-text">切换引擎，重新加载...</p></div>';
    });
    // 重新加载结论 Tab 数据
    loadMatchData(false, engine);
    // 切换到结论 Tab
    switchTab('conclusion');
  }

  window.cacheUI.onRefresh('match', () => loadMatchData(true, currentEngine));
  // 初始加载: 默认选中结论 Tab
  loadMatchData(false, 'elo');
  </script>
</body>
</html>
