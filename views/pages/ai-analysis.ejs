<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/ai-analysis.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="ai-analysis-page">
      <!-- 主内容区：初始加载状态 -->
      <div id="ai-analysis-loading" class="ai-loading-state" <% if (initialAnalysis) { %>style="display:none"<% } %>>
        <div class="ai-loading-spinner"></div>
        <h2>正在生成 AI 分析...</h2>
        <p class="ai-loading-steps">
          <span class="step active" id="step-aggregate">① 聚合数据源</span>
          <span class="step" id="step-llm">② 调用 AI 引擎</span>
          <span class="step" id="step-parse">③ 生成报告</span>
        </p>
      </div>

      <!-- AI 分析内容 -->
      <div id="ai-analysis-content" class="ai-content" <% if (!initialAnalysis) { %>style="display:none"<% } %>>
        <!-- 页面标题栏 -->
        <div class="ai-header">
          <a href="/match/<%= team1Slug %>/<%= team2Slug %>" class="ai-back-link">← 返回比赛详情</a>
          <button class="btn btn-sm btn-ai" onclick="refreshAnalysis()">🔄 刷新分析</button>
          <span id="ai-cache-badge" class="ai-cache-badge" style="display:none">缓存</span>
        </div>

        <!-- 第1屏: Hero -->
        <div class="ai-hero" id="ai-hero">
          <div class="ai-hero-meta">
            <span class="ai-stage-badge" id="ai-stage">2026 世界杯</span>
            <span class="ai-date" id="ai-date">加载中...</span>
          </div>
          <div class="ai-hero-teams" id="ai-hero-teams">
            <div class="ai-team home"><span class="ai-team-name" id="ai-home-name">--</span></div>
            <div class="ai-vs">vs</div>
            <div class="ai-team away"><span class="ai-team-name" id="ai-away-name">--</span></div>
          </div>
          <div class="ai-prob-cards" id="ai-prob-cards">
            <div class="ai-prob-card card-home">
              <div class="prob-pct" id="ai-home-prob">--</div>
              <div class="prob-label">主胜</div>
            </div>
            <div class="ai-prob-card card-draw">
              <div class="prob-pct" id="ai-draw-prob">--</div>
              <div class="prob-label">平局</div>
            </div>
            <div class="ai-prob-card card-away">
              <div class="prob-pct" id="ai-away-prob">--</div>
              <div class="prob-label">客胜</div>
            </div>
          </div>
          <div class="ai-hero-details" id="ai-hero-details">
            <div class="detail-item"><span class="label">AI 推荐</span><span class="value" id="ai-pick">--</span></div>
            <div class="detail-item"><span class="label">置信度</span><span class="value" id="ai-confidence">--</span></div>
            <div class="detail-item"><span class="label">预测比分</span><span class="value" id="ai-score">--</span></div>
            <div class="detail-item"><span class="label">大小球</span><span class="value" id="ai-ou">--</span></div>
            <div class="detail-item"><span class="label">预期总进球</span><span class="value" id="ai-xg-total">--</span></div>
            <div class="detail-item"><span class="label">加时概率</span><span class="value" id="ai-et">--</span></div>
            <div class="detail-item"><span class="label">点球概率</span><span class="value" id="ai-pk">--</span></div>
            <div class="detail-item"><span class="label">最新赔率</span><span class="value" id="ai-best-odds">--</span></div>
          </div>
          <div class="ai-generated-at" id="ai-generated-at"></div>
        </div>

        <!-- 第2屏: AI 深度分析 -->
        <div class="ai-section ai-reasoning">
          <h2 class="section-title">🤖 AI 分析推理</h2>
          <div class="ai-reasoning-text" id="ai-reasoning">
            <p>AI 分析生成中...</p>
          </div>
          <div class="ai-factor-grid">
            <div class="factor-column">
              <h3>✅ 关键因素</h3>
              <ul id="ai-key-factors"></ul>
            </div>
            <div class="factor-column">
              <h3>⚠️ 风险因素</h3>
              <ul id="ai-risk-factors"></ul>
            </div>
          </div>
        </div>

        <!-- 第3屏: 赛程与实时数据 -->
        <div class="ai-section ai-schedule">
          <h2 class="section-title">📅 赛程与实时数据</h2>
          <div class="ai-schedule-grid">
            <div class="schedule-item"><span class="label">阶段</span><span id="ai-stage-detail">--</span></div>
            <div class="schedule-item"><span class="label">日期</span><span id="ai-match-date">--</span></div>
            <div class="schedule-item"><span class="label">状态</span><span id="ai-match-status" class="status-badge">--</span></div>
          </div>
          <div class="ai-data-refresh-note">
            <p>数据来源: 本地种子数据 · 更新频率: 手动更新</p>
          </div>
        </div>

        <!-- 第4屏: 核心历史与表现 -->
        <div class="ai-section ai-history">
          <h2 class="section-title">📊 核心历史与表现数据</h2>
          <div class="ai-history-grid">
            <div class="history-card">
              <h4 id="ai-h-home" class="team-label">主队</h4>
              <div class="form-indicator" id="ai-h-form"></div>
              <p>近5场进球: <span id="ai-h-gf">0</span></p>
              <p>近5场失球: <span id="ai-h-ga">0</span></p>
            </div>
            <div class="history-card">
              <h4 id="ai-h-away" class="team-label">客队</h4>
              <div class="form-indicator" id="ai-a-form"></div>
              <p>近5场进球: <span id="ai-a-gf">0</span></p>
              <p>近5场失球: <span id="ai-a-ga">0</span></p>
            </div>
          </div>
        </div>

        <!-- 第5屏: 数据源参考 (可折叠) -->
        <div class="ai-section ai-sources">
          <h2 class="section-title">📊 AI 使用的数据源</h2>
          <div class="ai-sources-list" id="ai-sources-list">
            <div class="source-item" data-source="elo">
              <div class="source-header" onclick="toggleSource(this)">
                <span class="source-icon">📈</span>
                <span class="source-name">Elo 模型</span>
                <span class="source-status" id="src-elo-status">❌ 不可用</span>
                <span class="toggle-arrow">▶</span>
              </div>
              <div class="source-body" id="src-elo-body"></div>
            </div>
            <div class="source-item" data-source="ml">
              <div class="source-header" onclick="toggleSource(this)">
                <span class="source-icon">🤖</span>
                <span class="source-name">ML 模型 v1</span>
                <span class="source-status" id="src-ml-status">❌ 不可用</span>
                <span class="toggle-arrow">▶</span>
              </div>
              <div class="source-body" id="src-ml-body"></div>
            </div>
            <div class="source-item" data-source="ensemble">
              <div class="source-header" onclick="toggleSource(this)">
                <span class="source-icon">🧠</span>
                <span class="source-name">集成学习</span>
                <span class="source-status" id="src-ensemble-status">❌ 不可用</span>
                <span class="toggle-arrow">▶</span>
              </div>
              <div class="source-body" id="src-ensemble-body"></div>
            </div>
            <div class="source-item" data-source="odds">
              <div class="source-header" onclick="toggleSource(this)">
                <span class="source-icon">🏦</span>
                <span class="source-name">市场赔率共识</span>
                <span class="source-status" id="src-odds-status">❌ 不可用</span>
                <span class="toggle-arrow">▶</span>
              </div>
              <div class="source-body" id="src-odds-body"></div>
            </div>
            <div class="source-item" data-source="polymarket">
              <div class="source-header" onclick="toggleSource(this)">
                <span class="source-icon">📉</span>
                <span class="source-name">Polymarket</span>
                <span class="source-status" id="src-polymarket-status">❌ 不可用</span>
                <span class="toggle-arrow">▶</span>
              </div>
              <div class="source-body" id="src-polymarket-body"></div>
            </div>
            <div class="source-item" data-source="lottery">
              <div class="source-header" onclick="toggleSource(this)">
                <span class="source-icon">🎫</span>
                <span class="source-name">竞彩网</span>
                <span class="source-status" id="src-lottery-status">❌ 不可用</span>
                <span class="toggle-arrow">▶</span>
              </div>
              <div class="source-body" id="src-lottery-body"></div>
            </div>
            <div class="source-item" data-source="form">
              <div class="source-header" onclick="toggleSource(this)">
                <span class="source-icon">📋</span>
                <span class="source-name">近期状态</span>
                <span class="source-status" id="src-form-status">❌ 不可用</span>
                <span class="toggle-arrow">▶</span>
              </div>
              <div class="source-body" id="src-form-body"></div>
            </div>
            <div class="source-item" data-source="knockout">
              <div class="source-header" onclick="toggleSource(this)">
                <span class="source-icon">⚔️</span>
                <span class="source-name">淘汰赛加时/点球</span>
                <span class="source-status" id="src-knockout-status">❌ 不可用</span>
                <span class="toggle-arrow">▶</span>
              </div>
              <div class="source-body" id="src-knockout-body"></div>
            </div>
          </div>
        </div>

        <!-- 第6屏: 模型对比 -->
        <div class="ai-section ai-comparison">
          <h2 class="section-title">📊 各信源概率对比</h2>
          <div class="comparison-table-wrapper">
            <table class="comparison-table" id="ai-comparison-table">
              <thead>
                <tr>
                  <th>信源</th>
                  <th>主胜</th>
                  <th>平局</th>
                  <th>客胜</th>
                </tr>
              </thead>
              <tbody id="comparison-body">
                <tr><td colspan="4">数据加载中...</td></tr>
              </tbody>
            </table>
          </div>
          <p class="comparison-note">AI 综合所有数据源后得出的独立分析</p>
        </div>

        <!-- 底部导航 -->
        <div class="ai-footer">
          <a href="/match/<%= team1Slug %>/<%= team2Slug %>" class="btn btn-secondary">← 返回比赛详情</a>
          <button class="btn btn-primary" onclick="refreshAnalysis()">🔄 刷新分析</button>
        </div>
      </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    // 服务端注入的初始数据（必须在 ai-analysis.js 之前定义）
    const phase14Data = {
      team1Slug: '<%= team1Slug %>',
      team2Slug: '<%= team2Slug %>',
      team1Name: '<%= team1Name %>',
      team2Name: '<%= team2Name %>',
      initialAnalysis: <%- initialAnalysis || 'null' %>,
      initialDataSources: <%- initialDataSources || 'null' %>,
      initialSourceProbabilities: <%- initialSourceProbabilities || 'null' %>,
      initialRecentForm: <%- initialRecentForm || 'null' %>,
      initialMatchInfo: <%- initialMatchInfo || 'null' %>,
      aiEnabled: <%= aiEnabled %>
    };
  </script>
  <script src="/js/ai-analysis.js"></script>
</body>
</html>
