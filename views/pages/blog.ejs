          </div>
          <a href="/blog/<%= a.slug %>" class="blog-card-link">阅读全文 →</a>
        </div>
      <% }); %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script>
  fetch('/api/blog/news?_t=' + Date.now())
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var grid = document.getElementById('news-grid');
      if (!data.items || data.items.length === 0) {
        return;
      }
      var html = '';
      data.items.forEach(function(item) {
        var dateStr = new Date(data.fetchedAt).toLocaleDateString('zh-CN');
        html += '<a class="blog-card" href="' + item.url + '" target="_blank" rel="noopener">' +
          '<div class="blog-card-date">' + dateStr + '</div>' +
          '<div class="blog-card-title">' + item.title + '</div>' +
          '<div class="blog-card-excerpt">来自 ' + (item.source || '新华网') + ' 的最新世界杯资讯报道</div>' +
          '<div class="blog-card-link">📰 ' + (item.source || '新华网') + ' →</div>' +
          '</a>';
      });
      grid.innerHTML = html;
      var ts = document.getElementById('news-timestamp');
      if (data.fetchedAt) ts.textContent = '· ' + new Date(data.fetchedAt).toLocaleString('zh-CN');
    })
    .catch(function(e) {
      document.getElementById('news-grid').innerHTML = '<div class="error-muted">⚠️ 资讯加载失败</div>';
    });
  </script>
</body>
</html>
