    </div>
    <div class="disclaimer-banner">
      ⚠️ 以下文章内容均为基于数据的分析解读，仅供娱乐参考
    </div>

    <!-- 最新资讯（实时数据） -->
    <h2 class="section-heading">
      <span class="live-dot"></span>
      最新资讯
      <span id="news-timestamp" class="ts"></span>
    </h2>
    <div id="news-grid" class="blog-grid">
      <div class="loading-muted">加载最新资讯...</div>
    </div>

    <!-- 深度分析 -->
