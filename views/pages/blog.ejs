<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <style>
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 24px;
      margin-top: 24px;
    }
    .blog-card {
      background: #1a2332;
      border: 1px solid #2a3a4e;
      border-radius: 12px;
      padding: 20px;
      transition: border-color 0.2s, transform 0.15s;
      display: flex;
      flex-direction: column;
    }
    .blog-card:hover {
      border-color: #4a8bc2;
      transform: translateY(-2px);
    }
    /* 外链卡片也用相同样式 */
    a.blog-card {
      text-decoration: none;
      color: inherit;
    }
    .blog-card-date {
      font-size: 0.82rem;
      color: #6a7a8e;
      margin-bottom: 8px;
    }
    .blog-card-title {
      font-size: 1.15rem;
      font-weight: 600;
      color: #e0e8f0;
      margin-bottom: 8px;
      line-height: 1.4;
    }
    .blog-card-excerpt {
      font-size: 0.9rem;
      color: #8a9aaa;
      line-height: 1.55;
      margin-bottom: 14px;
      flex: 1;
    }
    .blog-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 14px;
    }
    .blog-tag {
      display: inline-block;
      background: #2a3a4e;
      color: #8ab8e0;
      font-size: 0.75rem;
      padding: 3px 9px;
      border-radius: 999px;
      white-space: nowrap;
    }
    .blog-card-link {
      display: inline-block;
      color: #4a8bc2;
      font-size: 0.88rem;
      font-weight: 500;
      text-decoration: none;
      align-self: flex-start;
    }
    .blog-card-link:hover {
      text-decoration: underline;
    }
    .section-heading {
      font-size: 1.1rem;
      margin: 28px 0 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-heading:first-of-type {
      margin-top: 0;
    }
    .section-heading .live-dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse 2s infinite;
    }
    .section-heading .ts {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 400;
    }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
    .loading-muted { text-align: center; padding: 30px; color: var(--text-muted); }
    .error-muted { text-align: center; padding: 16px; color: #ef4444; font-size: 0.82rem; }
    @media (max-width: 600px) {
      .blog-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
