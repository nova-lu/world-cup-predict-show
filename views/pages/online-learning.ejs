<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || '在线学习看板' %></title>
  <link rel="stylesheet" href="/css/app.css">
  <style>
    .ol-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .ol-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; }
    .ol-card-label { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.3rem; }
    .ol-card-val { font-size: 1.3rem; font-weight: 700; color: var(--text-color); }

    .ol-timeline { margin: 1rem 0 2rem; }
    .ol-tl-item { display: flex; gap: 0.8rem; padding: 0.5rem 0; border-left: 2px solid var(--border); padding-left: 1rem; }
    .ol-tl-dot { font-size: 0.6rem; line-height: 1.5rem; }
    .ol-tl-dot.stable { color: #22c55e; }
    .ol-tl-dot.rolled { color: #ef4444; }
    .ol-tl-dot.training { color: #eab308; }
    .ol-tl-content { font-size: 0.85rem; color: var(--text-muted); }
    .ol-tl-content small { color: var(--text-muted); opacity: 0.7; }

    .mt-3 { margin-top: 1.5rem; }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container main-content">
    <div class="page-header">
      <h1>🤖 在线学习看板</h1>
      <p class="page-subtitle">赛时模型增量更新状态与版本历史</p>
    </div>

    <div id="ol-loading" class="loading-large">加载在线学习状态...</div>
    <div id="ol-error" class="empty-state" style="display:none">
      <p>⚠️ 在线学习引擎未启用或数据不可用</p>
      <button class="btn" onclick="loadOLData()">重试</button>
    </div>

    <div id="ol-content" style="display:none">
      <!-- 状态卡片 -->
      <div class="ol-cards">
        <div class="ol-card">
          <div class="ol-card-label">引擎状态</div>
          <div class="ol-card-val" id="ol-status">-</div>
        </div>
        <div class="ol-card">
          <div class="ol-card-label">当前版本</div>
          <div class="ol-card-val" id="ol-version">v1</div>
        </div>
        <div class="ol-card">
          <div class="ol-card-label">今日更新次数</div>
          <div class="ol-card-val" id="ol-updates-today">0</div>
        </div>
        <div class="ol-card">
          <div class="ol-card-label">最新 Log Loss</div>
          <div class="ol-card-val" id="ol-ll">-</div>
        </div>
      </div>

      <!-- 版本时间线 -->
      <h2 class="section-title">版本时间线</h2>
      <div class="ol-timeline" id="ol-timeline">
        <div class="ol-tl-item">
          <span class="ol-tl-dot stable">●</span>
          <div class="ol-tl-content">
            <strong>v1 (stable)</strong> — 初始模型<br>
            <small>Base log_loss: 0.906 · ECE: 0.042</small>
          </div>
        </div>
      </div>

      <!-- 融合状态 -->
      <h2 class="section-title mt-3">赔率融合状态</h2>
      <div id="fusion-status-content">
        <div class="loading-sm">加载融合配置...</div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
  async function loadOLData() {
    document.getElementById('ol-loading').style.display = 'block';
    document.getElementById('ol-error').style.display = 'none';
    document.getElementById('ol-content').style.display = 'none';

    try {
      const r = await fetch('/api/odds/fusion/status');
      const data = await r.json();
      document.getElementById('ol-loading').style.display = 'none';
      document.getElementById('ol-content').style.display = 'block';

      document.getElementById('ol-status').textContent = data.enabled ? '🟢 已启用' : '🔴 未启用';
      document.getElementById('ol-version').textContent = 'v1 (stable)';

      const fc = document.getElementById('fusion-status-content');
      fc.innerHTML = `
        <div class="ol-cards" style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr))">
          <div class="ol-card"><div class="ol-card-label">融合策略</div><div class="ol-card-val" style="font-size:1rem">${data.strategy || '-'}</div></div>
          <div class="ol-card"><div class="ol-card-label">源权重 (oddsApi)</div><div class="ol-card-val" style="font-size:1rem">${((data.sourceWeights?.oddsApi || 0) * 100).toFixed(0)}%</div></div>
          <div class="ol-card"><div class="ol-card-label">源权重 (Polymarket)</div><div class="ol-card-val" style="font-size:1rem">${((data.sourceWeights?.polymarket || 0) * 100).toFixed(0)}%</div></div>
          <div class="ol-card"><div class="ol-card-label">源权重 (Model)</div><div class="ol-card-val" style="font-size:1rem">${((data.sourceWeights?.model || 0) * 100).toFixed(0)}%</div></div>
        </div>
        <div style="color:var(--text-muted);font-size:0.8rem">
          信源 Brier 历史: ${Object.entries(data.sourceBriers || {}).map(([k, v]) => `${k}: ${v != null ? v.toFixed(4) : '暂无'}`).join(' · ')}
        </div>
      `;
    } catch(e) {
      document.getElementById('ol-loading').style.display = 'none';
      document.getElementById('ol-error').style.display = 'block';
      document.getElementById('ol-error').querySelector('p').textContent += ': ' + e.message;
    }
  }

  document.addEventListener('DOMContentLoaded', loadOLData);
  </script>
</body>
</html>