<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <style>
    /* ===== Bracket Container ===== */
    #bracket-container {
      display: flex;
      gap: 20px;
      position: relative;
    }

    /* ===== Sidebar ===== */
    .bracket-sidebar {
      width: 240px;
      flex-shrink: 0;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      align-self: flex-start;
      position: sticky;
      top: 80px;
    }
    .bracket-sidebar h3 {
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 12px;
      color: var(--text-muted);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }
    .champ-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 0;
      border-bottom: 1px solid rgba(48,54,61,0.4);
      font-size: 0.82rem;
      cursor: default;
      transition: background 0.1s;
    }
    .champ-row:hover { background: var(--bg-hover); border-radius: 4px; padding-left: 4px; }
    .champ-rank { font-weight: 700; color: var(--text-muted); width: 20px; text-align: right; font-size: 0.78rem; }
    .champ-flag { font-size: 1.1rem; }
    .champ-name { flex: 1; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .champ-pct { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--accent-green); width: 48px; text-align: right; }
    .champ-bar-cell { width: 60px; }
    .champ-bar {
      display: block;
      height: 6px;
      background: linear-gradient(90deg, var(--accent-green), var(--accent));
      border-radius: 3px;
      transition: width 0.5s;
      min-width: 3px;
    }

    /* ===== Bracket Tree — CSS Grid 精确布局 ===== */
    .bracket-tree {
      flex: 1;
      min-width: 0;
      overflow-x: auto;
      padding: 10px 0 20px;
    }
    .bracket-grid {
      display: grid;
      grid-template-rows: repeat(16, auto);
      grid-template-columns: minmax(170px, 1fr) minmax(170px, 1fr) minmax(170px, 1fr) minmax(170px, 1fr) minmax(170px, 1fr) 100px;
      gap: 6px 12px;
      min-width: 1000px;
    }

    /* Round column headers — each spans all 16 rows via a single header placeholder */
    .bracket-round-col {
      display: contents; /* children are placed directly in the grid */
    }
    .round-label {
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      text-align: center;
      padding: 4px 0;
      background: rgba(255,255,255,0.03);
      border-radius: var(--radius-sm);
      margin-bottom: 4px;
    }

    /* Match card */
    .bracket-match {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 6px 10px;
      cursor: default;
      transition: all 0.15s;
      font-size: 0.75rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 48px;
    }
    .bracket-match:hover {
      border-color: var(--accent);
      background: var(--bg-hover);
    }
    .bracket-match .matchup {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .bracket-match .team-line {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .bracket-match .team-line .flag { font-size: 0.8rem; }
    .bracket-match .team-line .name {
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .bracket-match .team-line .slot-label {
      font-size: 0.65rem;
      color: var(--text-muted);
      font-weight: 400;
      padding: 1px 4px;
      background: rgba(148,163,184,0.08);
      border-radius: 3px;
    }
    .bracket-match .match-label {
      font-size: 0.6rem;
      color: var(--text-muted);
      margin-bottom: 1px;
    }
    .bracket-match .prob-sub {
      font-size: 0.6rem;
      color: var(--text-muted);
    }

    /* Champion node */
    .champion-node {
      background: linear-gradient(135deg, rgba(35,134,54,0.2), rgba(56,139,253,0.15));
      border: 2px solid var(--accent-green);
      border-radius: var(--radius);
      padding: 10px 6px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
    }
    .champion-node .trophy { font-size: 1.3rem; }
    .champion-node .champ-name { font-size: 0.85rem; font-weight: 700; }
    .champion-node .champ-flag { font-size: 1.1rem; }
    .champion-node .champ-prob { font-size: 0.72rem; color: var(--accent-green); font-weight: 600; }

    /* ===== Responsive ===== */
    @media (max-width: 1024px) {
      #bracket-container { flex-direction: column; }
      .bracket-sidebar { width: 100%; position: static; }
    }
    @media (max-width: 700px) {
      .bracket-tree { padding: 8px 0; }
      .bracket-grid { min-width: 860px; }
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="page-header">
      <h1>淘汰赛树</h1>
      <p class="subtitle" id="bracket-summary">2026世界杯 · 加载中...</p>
    </div>
    <div class="disclaimer-banner">
      ⚠️ 淘汰赛对阵基于蒙特卡洛模拟的晋级概率分布，对阵双方为当前模拟中最可能晋级的球队
    </div>
    <div id="loading-spinner" class="loading">🏆 正在构建淘汰赛树...</div>

    <div id="bracket-container" style="display:none">
      <!-- Sidebar champion probabilities -->
      <div class="bracket-sidebar" id="bracket-sidebar"></div>
      <!-- Main bracket tree -->
      <div class="bracket-tree" id="bracket-tree"></div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
  // Render champion probabilities sidebar
  function renderSidebar(teams) {
    const sidebar = document.getElementById('bracket-sidebar');
    const entries = Object.entries(teams)
      .map(([slug, t]) => ({ slug: slug, ...t }))
      .filter(t => t.champion > 0)
      .sort((a, b) => b.champion - a.champion)
      .slice(0, 8);

    let html = '<h3>\uD83C\uDFC6 夺冠概率 Top 8</h3>';
    entries.forEach((t, i) => {
      const pct = t.champion;
      const barW = Math.max(pct, 2);
      html += '<div class="champ-row">' +
        '<span class="champ-rank">' + (i + 1) + '</span>' +
        '<span class="champ-flag">' + (t.flag || '\u26BD') + '</span>' +
        '<span class="champ-name">' + (t.name || t.slug) + '</span>' +
        '<span class="champ-pct">' + pct + '%</span>' +
        '<span class="champ-bar-cell"><span class="champ-bar" style="width:' + barW + '%"></span></span>' +
        '</div>';
    });
    sidebar.innerHTML = html;
  }

  // Try to find the most probable team for a given slot
  function findTeamForSlot(slot, teams, rounds, roundKey) {
    // Direct team slug match
    if (teams[slot]) return teams[slot];

    // Group position: "1A", "2D" etc
    const groupPosMatch = slot.match(/^(\d+)([A-Z])$/);
    if (groupPosMatch) {
      // We can't resolve this without group-stage data
      return null;
    }

    // Winner slot: "W73", "W89" etc — find the match that produces this slot
    // and pick the more likely team from its home/away participants
    const allRoundKeys = ['round32', 'round16', 'quarter', 'semi', 'final'];
    for (const rk of allRoundKeys) {
      const ml = rounds[rk] || [];
      for (const m of ml) {
        if (m.slot === slot) {
          // Resolve both participants — if they're also winner slots, recurse
          const resolveSlot = (s) => {
            if (teams[s]) return teams[s]; // direct team slug
            return findTeamForSlot(s, teams, rounds, rk); // recurse for nested winner slots
          };
          const homeTeam = m.home ? resolveSlot(m.home) : null;
          const awayTeam = m.away ? resolveSlot(m.away) : null;
          if (homeTeam && awayTeam) {
            const field = rk === 'round32' ? 'round32' : rk === 'round16' ? 'round16' : rk === 'quarter' ? 'quarter' : rk === 'semi' ? 'semi' : 'champion';
            return (homeTeam[field] || 0) >= (awayTeam[field] || 0) ? homeTeam : awayTeam;
          }
          return homeTeam || awayTeam || null;
        }
      }
    }

    // Third-best group slot format like "3C/3D/3F/3G/3H"
    const groupSlugs = slot.split('/').map(s => s.trim());
    const knownSlug = groupSlugs.find(s => teams[s]);
    if (knownSlug) return teams[knownSlug];

    return null;
  }

  // Build bracket tree with CSS Grid explicit row/col placement
  function renderBracket(data) {
    const { rounds, teams } = data;
    const container = document.getElementById('bracket-tree');

    // Grid: 17 rows (1 header + 16 data), 6 columns
    let html = '<div class="bracket-grid" style="grid-template-rows:auto repeat(16,auto)">';

    const cols = ['round32', 'round16', 'quarter', 'semi', 'final', 'champion'];
    const colLabels = ['<span class="round-label">R32 · 32强</span>', '<span class="round-label">R16 · 16强</span>',
      '<span class="round-label">QF · 8强</span>', '<span class="round-label">SF · 4强</span>',
      '<span class="round-label">FINAL · 决赛</span>', '<span class="round-label">🏆 冠军</span>'];

    // Column 1: R32 — 16 matches at rows 2..17, col 1
    const r32 = rounds.round32 || [];
    r32.forEach((match, j) => {
      const homeTeam = findTeamForSlot(match.home, teams, rounds, 'round32');
      const awayTeam = findTeamForSlot(match.away, teams, rounds, 'round32');
      html += matchCard(match, homeTeam, awayTeam, j + 2, 1, 1);
    });

    // Column 2: R16 — 8 matches, each spanning 2 rows
    const r16 = rounds.round16 || [];
    r16.forEach((match, i) => {
      const homeTeam = findTeamForSlot(match.home, teams, rounds, 'round16');
      const awayTeam = findTeamForSlot(match.away, teams, rounds, 'round16');
      html += matchCard(match, homeTeam, awayTeam, 2 * i + 2, 2, 2);
    });

    // Column 3: QF — 4 matches, each spanning 4 rows
    const qf = rounds.quarter || [];
    qf.forEach((match, i) => {
      const homeTeam = findTeamForSlot(match.home, teams, rounds, 'quarter');
      const awayTeam = findTeamForSlot(match.away, teams, rounds, 'quarter');
      html += matchCard(match, homeTeam, awayTeam, 4 * i + 2, 3, 4);
    });

    // Column 4: SF — 2 matches, each spanning 8 rows
    const sf = rounds.semi || [];
    sf.forEach((match, i) => {
      const homeTeam = findTeamForSlot(match.home, teams, rounds, 'semi');
      const awayTeam = findTeamForSlot(match.away, teams, rounds, 'semi');
      html += matchCard(match, homeTeam, awayTeam, 8 * i + 2, 4, 8);
    });

    // Column 5: Final — 1 match, spanning 16 rows
    const finalMatch = (rounds.final || [])[0];
    if (finalMatch) {
      const homeTeam = findTeamForSlot(finalMatch.home, teams, rounds, 'final');
      const awayTeam = findTeamForSlot(finalMatch.away, teams, rounds, 'final');
      html += matchCard(finalMatch, homeTeam, awayTeam, 2, 5, 16);
    }

    // Column 6: Champion
    const champEntries = Object.entries(teams)
      .map(([slug, t]) => ({ slug, ...t }))
      .filter(t => t.champion > 0)
      .sort((a, b) => b.champion - a.champion);
    const champion = champEntries[0] || null;
    html += '<div class="champion-node" style="grid-row:2/span 16;grid-column:6">';
    html += '<div class="trophy">🏆</div>';
    if (champion) {
      html += '<div class="champ-flag">' + (champion.flag || '⚽') + '</div>';
      html += '<div class="champ-name">' + (champion.name || '?') + '</div>';
      html += '<div class="champ-prob">' + champion.champion + '%</div>';
    } else {
      html += '<div class="champ-name">待定</div>';
    }
    html += '</div>';

    // Column labels (row 1, each col)
    colLabels.forEach((label, ci) => {
      html += '<div style="grid-row:1;grid-column:' + (ci + 1) + '">' + label + '</div>';
    });

    html += '</div>'; // .bracket-grid
    container.innerHTML = html;

    // Summary
    const totalTeams = Object.keys(teams).length;
    document.getElementById('bracket-summary').textContent =
      '2026世界杯 · ' + totalTeams + ' 支球队 · 基于 ' + (data.simulations || '?').toLocaleString() + ' 次模拟';
  }

  // Generate a match card HTML with explicit grid position
  function matchCard(match, homeTeam, awayTeam, rowStart, col, rowSpan) {
    let html = '<div class="bracket-match" style="grid-row:' + rowStart + '/span ' + rowSpan + ';grid-column:' + col + '" title="' + match.home + ' vs ' + match.away + '">';
    html += '<div class="matchup">';
    // Home
    html += '<div class="team-line">';
    if (homeTeam) {
      html += '<span class="flag">' + (homeTeam.flag || '⚽') + '</span>';
      html += '<span class="name">' + (homeTeam.name || match.home) + '</span>';
    } else {
      html += '<span class="slot-label">' + match.home + '</span>';
    }
    html += '</div>';
    // Away
    html += '<div class="team-line">';
    if (awayTeam) {
      html += '<span class="flag">' + (awayTeam.flag || '⚽') + '</span>';
      html += '<span class="name">' + (awayTeam.name || match.away) + '</span>';
    } else {
      html += '<span class="slot-label">' + match.away + '</span>';
    }
    html += '</div>';
    html += '</div>';
    html += '</div>';
    return html;
  }

  async function loadBracketData(force) {
    if (force) {
      document.getElementById('loading-spinner').style.display = 'flex';
      document.getElementById('bracket-container').style.display = 'none';
    }
    try {
      const data = await cachedFetch('/api/bracket', { force });
      document.getElementById('loading-spinner').style.display = 'none';
      document.getElementById('bracket-container').style.display = 'flex';
      renderSidebar(data.teams || {});
      renderBracket(data);
    } catch (err) {
      document.getElementById('loading-spinner').innerHTML = '⚠️ 淘汰赛数据加载失败: ' + err.message;
    }
  }

  // Register refresh callback
  window.cacheUI.onRefresh('bracket', () => loadBracketData(true));

  // Load data on page load
  loadBracketData(false);
  </script>
</body>
</html>
