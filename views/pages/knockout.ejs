<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <style>
    /* Dashboard layout */
    .ko-dashboard {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .ko-section {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 20px;
    }
    .ko-section h2 {
      font-size: 1.05rem;
      font-weight: 600;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
    }
    .ko-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    /* Match cards */
    .ko-match-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ko-match-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      background: rgba(255,255,255,0.03);
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      cursor: pointer;
      transition: background 0.12s;
    }
    .ko-match-row:hover { background: var(--bg-hover); }
    .ko-match-row .teams { flex: 1; display: flex; align-items: center; gap: 6px; }
    .ko-match-row .score { font-weight: 700; min-width: 30px; text-align: center; }
    .ko-match-row .stage { font-size: 0.7rem; color: var(--text-muted); min-width: 50px; }
    .ko-match-row .time { font-size: 0.72rem; color: var(--text-muted); min-width: 80px; text-align: right; }

    /* Qualified 32 grid */
    .qualified-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 8px;
    }
    .qualified-team {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      background: rgba(255,255,255,0.03);
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      cursor: default;
      transition: background 0.12s;
    }
    .qualified-team:hover { background: var(--bg-hover); }
    .qualified-team .rank-label {
      font-size: 0.68rem;
      color: var(--text-muted);
      background: rgba(255,255,255,0.06);
      padding: 1px 5px;
      border-radius: 3px;
    }
    .qualified-team.real {
      border-left: 3px solid var(--accent-green, #22c55e);
    }
    .qualified-team.predicted {
      border-left: 3px solid var(--accent, #3b82f6);
    }
    .badge-real {
      display: inline-block;
      background: rgba(34,197,94,0.15);
      color: #22c55e;
      font-size: 0.6rem;
      padding: 1px 5px;
      border-radius: 3px;
      margin-left: 4px;
    }
    .badge-pred {
      display: inline-block;
      background: rgba(59,130,246,0.15);
      color: #5b9ef4;
      font-size: 0.6rem;
      padding: 1px 5px;
      border-radius: 3px;
      margin-left: 4px;
    }
    .ko-match-row.confirmed .stage { color: var(--accent-green, #22c55e); }

    /* Third-rank table */
    .third-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    .third-table th {
      text-align: left;
      padding: 5px 8px;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.72rem;
      text-transform: uppercase;
      border-bottom: 1px solid var(--border);
    }
    .third-table td {
      padding: 5px 8px;
      border-bottom: 1px solid rgba(48,54,61,0.3);
    }
    .third-table .qualify-row td {
      background: rgba(35, 134, 54, 0.08);
    }
    .third-table .border-row td {
      border-top: 2px solid var(--accent-green);
    }
    .third-rank-note {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 8px;
    }

    /* Bracket tree in knockout page */
    .ko-bracket-wrap {
      overflow-x: auto;
    }
    .ko-bracket-grid {
      display: grid;
      grid-template-rows: auto repeat(16, 1fr);
      grid-template-columns: minmax(160px, 1fr) minmax(160px, 1fr) minmax(160px, 1fr) minmax(160px, 1fr) minmax(160px, 1fr) 100px;
      gap: 5px 10px;
      min-width: 950px;
    }
    .ko-bracket-grid .round-label {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      text-align: center;
      padding: 3px 0;
    }
    .ko-bracket-grid .bracket-match {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 4px 7px;
      cursor: pointer;
      transition: all 0.12s;
      font-size: 0.7rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      min-height: 38px;
      text-decoration: none;
      color: inherit;
      position: relative;
    }
    .ko-bracket-grid .bracket-match:hover { background: var(--bg-hover); }
    .ko-bracket-grid .bracket-match.finished {
      border-left-color: var(--accent-green, #22c55e) !important;
    }
    .ko-bracket-grid .bracket-match.unresolved {
      background: rgba(255,255,255,0.015);
      border-style: dashed;
      opacity: 0.5;
      cursor: default;
    }
    .ko-bracket-grid .bracket-match.unresolved:hover { background: rgba(255,255,255,0.015); }
    .ko-bracket-grid .team-line {
      display: flex;
      align-items: center;
      gap: 4px;
      line-height: 1.3;
    }
    .ko-bracket-grid .team-line .name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ko-bracket-grid .team-line .elo-badge { font-size: 0.62rem; color: var(--text-muted); background: rgba(255,255,255,0.05); padding: 0 4px; border-radius: 2px; }
    .ko-bracket-grid .team-line .score-badge { font-weight: 700; font-size: 0.72rem; color: var(--accent-green); min-width: 16px; text-align: center; }
    .ko-bracket-grid .team-line.winner .score-badge { color: var(--accent-green); }
    .ko-bracket-grid .champion-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      background: linear-gradient(135deg, rgba(250,204,21,0.08), rgba(250,204,21,0.02));
      border: 1px solid rgba(250,204,21,0.2);
      border-radius: var(--radius);
      padding: 10px;
    }
    .ko-bracket-grid .champion-node .trophy { font-size: 1.3rem; }
    .ko-bracket-grid .champion-node .champ-name { font-size: 0.8rem; font-weight: 700; }
    .ko-bracket-grid .champion-node .champ-prob { font-size: 0.68rem; color: var(--accent-green); font-weight: 600; }
    .ko-bracket-grid .match-label { font-size: 0.58rem; color: var(--text-muted); margin-bottom: 2px; }

    /* Tab navigation */
    .ko-tabs {
      display: flex;
      gap: 4px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .ko-tab {
      padding: 6px 16px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      cursor: pointer;
      background: rgba(255,255,255,0.03);
      border: 1px solid transparent;
      transition: all 0.12s;
    }
    .ko-tab:hover { background: var(--bg-hover); }
    .ko-tab.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .ko-panel { display: none; }
    .ko-panel.active { display: block; }

    /* Semi-final & final match cards */
    .big-match {
      background: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 22px;
      position: relative;
      overflow: hidden;
    }
    .big-match.final {
      background: linear-gradient(135deg, rgba(250,204,21,0.08), rgba(250,204,21,0.01));
      border-color: rgba(250,204,21,0.3);
    }
    .big-match.third {
      background: linear-gradient(135deg, rgba(205,127,50,0.08), rgba(205,127,50,0.01));
      border-color: rgba(205,127,50,0.25);
    }
    .big-match-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }
    .big-match-label {
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent);
    }
    .big-match.final .big-match-label { color: #facc15; }
    .big-match.third .big-match-label { color: #cd7f32; }
    .big-match-status {
      font-size: 0.72rem;
      color: var(--text-muted);
    }
    .big-match-status .live {
      color: var(--accent-green, #22c55e);
      animation: pulse 1.6s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    .big-match-body {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 18px;
      align-items: center;
    }
    .big-team {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .big-team.away { flex-direction: row-reverse; text-align: right; }
    .big-team .name-block { display: flex; flex-direction: column; gap: 4px; }
    .big-team.away .name-block { align-items: flex-end; }
    .big-team .team-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text);
    }
    .big-team .team-meta {
      font-size: 0.72rem;
      color: var(--text-muted);
      display: flex;
      gap: 6px;
    }
    .big-team.away .team-meta { justify-content: flex-end; }
    .big-team .team-flag-lg img,
    .big-team .team-flag-lg .flag-fallback {
      width: 44px;
      height: 30px;
      font-size: 1.5rem;
    }
    .big-team .team-flag-lg {
      width: 44px;
      height: 30px;
      flex-shrink: 0;
    }
    .big-team.winner .team-name { color: var(--accent-green, #22c55e); }
    .big-score {
      text-align: center;
      min-width: 90px;
    }
    .big-score .score-line {
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: 2px;
    }
    .big-score .vs-text {
      font-size: 0.85rem;
      color: var(--text-muted);
      padding: 12px 0;
    }
    .big-score .pens {
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .big-match-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      padding-top: 10px;
      border-top: 1px solid var(--border);
      font-size: 0.72rem;
      color: var(--text-muted);
    }
    .big-match-footer .prob {
      display: flex;
      gap: 12px;
    }
    .big-match-footer .prob b {
      color: var(--text);
    }
    .big-match-footer .badge {
      padding: 2px 8px;
      border-radius: 3px;
      font-size: 0.68rem;
    }
    .big-match-footer .badge.pred {
      background: rgba(59,130,246,0.15);
      color: #5b9ef4;
    }
    .big-match-footer .badge.real {
      background: rgba(34,197,94,0.15);
      color: #22c55e;
    }

    /* Semi-final & final layout grid */
    .sf-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .final-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .path-pill {
      display: inline-block;
      font-size: 0.66rem;
      color: var(--text-muted);
      background: rgba(255,255,255,0.05);
      padding: 1px 6px;
      border-radius: 3px;
      margin-right: 4px;
    }

    @media (max-width: 768px) {
      .ko-grid-2 { grid-template-columns: 1fr; }
      .qualified-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
      .sf-grid, .final-grid { grid-template-columns: 1fr; }
      .big-match-body { grid-template-columns: 1fr; gap: 12px; }
      .big-team.away { flex-direction: row; text-align: left; }
      .big-team.away .name-block { align-items: flex-start; }
      .big-team.away .team-meta { justify-content: flex-start; }
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="page-header">
      <h1>🏆 淘汰赛仪表盘 <span class="real-badge">实时数据</span></h1>
      <p class="subtitle" id="ko-summary">加载中...</p>
    </div>
    <div id="source-banner" class="success-banner" style="display:none">
      <span id="source-banner-text"></span>
      <span id="ko-freshness" style="margin-left:12px;font-size:0.78rem;color:var(--text-muted)"></span>
      <span id="ko-auto-refresh" style="margin-left:12px;font-size:0.72rem;color:var(--text-muted)"></span>
      <button id="ko-refresh-btn" onclick="loadKnockoutData(true)" style="margin-left:12px;font-size:0.72rem;border:1px solid var(--border);background:transparent;color:var(--text);border-radius:4px;padding:2px 10px;cursor:pointer">🔄 手动刷新</button>
    </div>
    <div id="loading-spinner" class="loading">🏆 加载淘汰赛数据...</div>

    <div id="ko-dashboard" class="ko-dashboard" style="display:none">
      <!-- Tab navigation -->
      <div class="ko-tabs" id="ko-tabs">
        <div class="ko-tab active" data-panel="bracket">🌳 晋级树</div>
        <div class="ko-tab" data-panel="matches">⚽ 比赛列表</div>
        <div class="ko-tab" data-panel="qualified">✅ 32强队伍</div>
        <div class="ko-tab" data-panel="r16-teams">🔵 16强队伍</div>
        <div class="ko-tab" data-panel="quarter-teams">🏅 8强队伍</div>
        <div class="ko-tab" data-panel="semi-teams">🔶 半决赛队伍</div>
        <div class="ko-tab" data-panel="semi">⚔️ 半决赛</div>
        <div class="ko-tab" data-panel="finals">🏆 季军赛 & 决赛</div>
        <div class="ko-tab" data-panel="third">📊 第三名竞争</div>
      </div>

      <!-- Panel 1: Bracket Tree -->
      <div class="ko-panel active" id="panel-bracket">
        <div class="ko-section">
          <h2>🌳 淘汰赛晋级树</h2>
          <div class="ko-bracket-wrap">
            <div class="ko-bracket-grid" id="ko-bracket-grid"></div>
          </div>
        </div>
      </div>

      <!-- Panel 2: Match list -->
      <div class="ko-panel" id="panel-matches">
        <div class="ko-grid-2">
          <div class="ko-section">
            <h2>✅ 已完赛</h2>
            <div class="ko-match-list" id="ko-finished"></div>
          </div>
          <div class="ko-section">
            <h2>⏳ 即将开赛</h2>
            <div class="ko-match-list" id="ko-upcoming"></div>
          </div>
        </div>
      </div>

      <!-- Panel 3: Qualified 32 teams -->
      <div class="ko-panel" id="panel-qualified">
        <div class="ko-section">
          <h2>✅ 已确定的 32 强球队</h2>
          <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:10px">
            12个小组前2名（24队）+ 最佳8个小组第三名
          </p>
          <div class="qualified-grid" id="ko-qualified"></div>
        </div>
      </div>

      <!-- Panel 3b: R16 teams -->
      <div class="ko-panel" id="panel-r16-teams">
        <div class="ko-section">
          <h2>🔵 晋级 16 强的球队</h2>
          <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:10px">
            32强淘汰赛胜者（含已完赛的真实结果和未赛比赛的模拟预测）
          </p>
          <div class="qualified-grid" id="ko-r16-teams"></div>
        </div>
      </div>

      <!-- Panel 3c: Quarter-final teams -->
      <div class="ko-panel" id="panel-quarter-teams">
        <div class="ko-section">
          <h2>🏅 晋级 8 强的球队</h2>
          <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:10px">
            16强淘汰赛胜者（含已完赛的真实结果和未赛比赛的模拟预测）
          </p>
          <div class="qualified-grid" id="ko-quarter-teams"></div>
        </div>
      </div>

      <!-- Panel 3d: Semi-final teams -->
      <div class="ko-panel" id="panel-semi-teams">
        <div class="ko-section">
          <h2>🔶 晋级 4 强的球队</h2>
          <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:10px">
            8强淘汰赛胜者（含已完赛的真实结果和未赛比赛的模拟预测）
          </p>
          <div class="qualified-grid" id="ko-semi-teams"></div>
        </div>
      </div>

      <!-- Panel 3e: Semi-final matches -->
      <div class="ko-panel" id="panel-semi">
        <div class="ko-section">
          <h2>⚔️ 半决赛对阵</h2>
          <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:10px">
            半决赛对决 · 胜者晋级决赛，负者进入季军赛
          </p>
          <div class="sf-grid" id="ko-semi-matches"></div>
        </div>
      </div>

      <!-- Panel 3f: 3rd/4th place + Final -->
      <div class="ko-panel" id="panel-finals">
        <div class="ko-section">
          <h2>🏆 季军赛 & 决赛</h2>
          <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:10px">
            半决赛两支败者争夺季军 · 半决赛两支胜者角逐冠军
          </p>
          <div class="final-grid" id="ko-finals-matches"></div>
        </div>
      </div>

      <!-- Panel 4: Third-rank -->
      <div class="ko-panel" id="panel-third">
        <div class="ko-section">
          <h2>📊 第三名竞争势态</h2>
          <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:10px">
            12个小组第3名中取最佳8支进入32强
          </p>
          <div id="ko-third-table-container"></div>
          <div class="third-rank-note" id="ko-third-note">加载中...</div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/bracket-lines.js"></script>
  <script>
  // ===== Tab switching =====
  document.getElementById('ko-tabs').addEventListener('click', function(e) {
    const tab = e.target.closest('.ko-tab');
    if (!tab) return;
    document.querySelectorAll('.ko-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.ko-panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('panel-' + tab.dataset.panel).classList.add('active');
  });

  // ===== SVG 旗帜 =====
  function flagHtml(info, size) {
    size = size || 'sm';
    if (!info) return '<span class="team-flag flag-' + size + '"><span class="flag-fallback">⚽</span></span>';
    var svgPath = info.flagPath || '';
    var emoji = info.flag || '\u26bd';
    if (svgPath) {
      return '<span class="team-flag flag-' + size + '"><img src="' + svgPath + '" alt="' + (info.name || '') + '" loading="lazy" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'inline\'"><span class="flag-fallback" style="display:none">' + emoji + '</span></span>';
    }
    return '<span class="team-flag flag-' + size + '"><span class="flag-fallback">' + emoji + '</span></span>';
  }

  // ===== 构建比赛卡片（用于 bracket grid） =====
  function buildMatchCard(match) {
    const home = match.homeInfo;
    const away = match.awayInfo;
    const finished = match.finished;
    const winnerSlug = match.winner;
    const isHomeWinner = winnerSlug && home && match.home === winnerSlug;
    const isAwayWinner = winnerSlug && away && match.away === winnerSlug;
    const homeColor = home?.color?.primary || '';

    // 如果两队都未确定（W-slot），跳过渲染（用占位格代替）
    const homeUnresolved = match.home && match.home.startsWith('W');
    const awayUnresolved = match.away && match.away.startsWith('W');
    if (homeUnresolved && awayUnresolved) {
      return '<div class="bracket-match unresolved" data-slot="' + match.slot + '"><div class="team-line"><span class="name" style="color:var(--text-muted)">待定</span></div><div class="team-line"><span class="name" style="color:var(--text-muted)">待定</span></div></div>';
    }

    var html = '<div class="bracket-match' + (finished ? ' finished' : '') + '" data-slot="' + match.slot + '" style="border-left:3px solid ' + homeColor + '">';
    if (match.label) html += '<div class="match-label">' + match.label + '</div>';
    // Home
    html += '<div class="team-line' + (isHomeWinner ? ' winner' : '') + '">';
    if (homeUnresolved) {
      html += '<span class="name" style="color:var(--text-muted)">待定</span>';
    } else if (home) {
      html += flagHtml(home, 'sm') + '<span class="name">' + (home.name || match.home) + '</span>';
      if (!finished) html += '<span class="elo-badge">' + home.elo + '</span>';
      if (finished && match.g1 != null) html += '<span class="score-badge">' + match.g1 + '</span>';
    } else {
      html += '<span class="name">' + match.home + '</span>';
    }
    html += '</div>';
    // Away
    html += '<div class="team-line' + (isAwayWinner ? ' winner' : '') + '">';
    if (awayUnresolved) {
      html += '<span class="name" style="color:var(--text-muted)">待定</span>';
    } else if (away) {
      html += flagHtml(away, 'sm') + '<span class="name">' + (away.name || match.away) + '</span>';
      if (!finished) html += '<span class="elo-badge">' + away.elo + '</span>';
      if (finished && match.g2 != null) html += '<span class="score-badge">' + match.g2 + '</span>';
    } else {
      html += '<span class="name">' + match.away + '</span>';
    }
    html += '</div>';
    html += '</div>';
    return html;
  }

  // ===== 渲染 Bracket Tree =====
  function renderBracketTree(roundData, mcTeams) {
    const grid = document.getElementById('ko-bracket-grid');
    var html = '';

    // Column labels
    var colLabels = ['32强', '16强', '8强', '半决赛', '决赛', '冠军'];
    colLabels.forEach(function(label, ci) {
      html += '<div class="round-label" style="grid-column:' + (ci + 1) + '">' + label + '</div>';
    });

    // 行号映射：每轮从哪行开始
    // round32: 16 matches, each spanning 1 row → rows 2-17
    // round16: 8 matches, each spanning 2 rows → rows 2,4,6,8,10,12,14,16
    // quarter: 4 matches, each spanning 4 rows → rows 2,6,10,14
    // semi: 2 matches, each spanning 8 rows → rows 2,10
    // final: 1 match, spanning 16 rows → row 2
    // champion: row 2, span 16

    var stageConfig = {
      round32: { col: 1, rowStart: 2, rowSpan: 1 },
      round16: { col: 2, rowStart: 2, rowSpan: 2 },
      quarter: { col: 3, rowStart: 2, rowSpan: 4 },
      semi: { col: 4, rowStart: 2, rowSpan: 8 },
      final: { col: 5, rowStart: 2, rowSpan: 16 },
    };

    // Render stages
    Object.keys(stageConfig).forEach(function(stage) {
      var cfg = stageConfig[stage];
      var matches = roundData[stage] || [];
      matches.forEach(function(m, i) {
        var rs = cfg.rowStart + i * cfg.rowSpan;
        html += buildMatchCard(m).replace('data-slot="', 'style="grid-row:' + rs + '/span ' + cfg.rowSpan + ';grid-column:' + cfg.col + ';" data-slot="');
      });
    });

    // === 找出已淘汰的球队 ===
    // 在已完赛的淘汰赛中，败者已被淘汰
    var eliminated = {};
    ['round32', 'round16', 'quarter', 'semi', 'final'].forEach(function(stage) {
      (roundData[stage] || []).forEach(function(m) {
        if (m.finished && m.winner && m.loser) {
          eliminated[m.loser] = true;
        } else if (m.finished && m.winner) {
          // 无 loser 字段时根据比分推断
          if (m.home && m.away && m.g1 != null && m.g2 != null) {
            var loser = m.winner === m.home ? m.away : m.home;
            eliminated[loser] = true;
          }
        }
      });
    });

    // === 冠军节点 ===
    // 优先使用实际裁定的决赛冠军（决赛已赛且有胜者）
    var actualChamp = null;
    var finalM = (roundData.final || [])[0];
    if (finalM && finalM.finished && finalM.winner && !finalM.winner.startsWith('W')) {
      actualChamp = finalM.winner;
    }

    var champ = null;
    if (actualChamp) {
      // 决赛已完赛，用实际冠军
      var t = mcTeams[actualChamp];
      champ = { slug: actualChamp, flag: t?.flag, flagPath: t?.flagPath, name: t?.name || actualChamp, champion: 100 };
    } else {
      // 从 MC 概率中排除已淘汰球队，取剩余中概率最高的
      var champEntries = Object.entries(mcTeams)
        .filter(function(e) { return !eliminated[e[0]]; })
        .map(function(e) { return { slug: e[0], flag: e[1].flag, flagPath: e[1].flagPath, name: e[1].name, champion: e[1].champion || 0 }; })
        .filter(function(t) { return t.champion > 0; })
        .sort(function(a, b) { return b.champion - a.champion; });
      champ = champEntries[0] || null;
    }

    html += '<div class="champion-node" style="grid-row:2/span 16;grid-column:6">';
    html += '<div class="trophy">\uD83C\uDFC6</div>';
    if (champ) {
      html += flagHtml({ flagPath: champ.flagPath, flag: champ.flag, name: champ.name }, 'md');
      html += '<div class="champ-name">' + (champ.name || '?') + '</div>';
      if (actualChamp) {
        html += '<div class="champ-prob" style="color:#facc15">🏆 冠军</div>';
      } else {
        html += '<div class="champ-prob">' + (champ.champion || 0).toFixed(1) + '%</div>';
      }
    } else {
      html += '<div class="champ-name">待定</div>';
    }
    html += '</div>';

    grid.innerHTML = html;
  }

  // ===== 渲染比赛列表（使用真实比赛数据） =====
  function renderMatchList(bracketRoundData, teamsProb) {
    var finished = [], upcoming = [];
    ['round32', 'round16', 'quarter', 'semi', 'final'].forEach(function(stage) {
      (bracketRoundData[stage] || []).forEach(function(m) {
        if (m.finished && m.g1 != null) finished.push(m);
        else if (m.home && m.away && !m.home.startsWith('W') && !m.away.startsWith('W')) {
          upcoming.push(m);
        }
      });
    });

    // 构建已完赛胜者集合（用来标记"已确认"的即将开赛）
    var realWinners = {};
    finished.forEach(function(m) { if (m.winner) realWinners[m.winner] = true; });

    function teamInfo(slug) {
      if (!slug) return null;
      var t = teamsProb[slug];
      if (!t) return { name: slug, flag: '⚽', flagPath: null };
      return t;
    }

    var stageNames = { round32: '32强', round16: '16强', quarter: '8强', semi: '半决赛', final: '决赛' };

    function matchRow(m) {
      var stageName = stageNames[Object.keys(stageNames).find(function(k) { return (bracketRoundData[k] || []).indexOf(m) >= 0; })] || '';
      var home = teamInfo(m.home), away = teamInfo(m.away);
      var winnerSlug = m.winner;
      var homeW = winnerSlug && m.home === winnerSlug;
      var awayW = winnerSlug && m.away === winnerSlug;
      // 确定是否"已确认"（双方都是已完赛R32的胜者）
      var isConfirmed = realWinners[m.home] && realWinners[m.away];
      var clickUrl = '/match/' + m.home + '/' + m.away;
      var h = '<div class="ko-match-row' + (isConfirmed ? ' confirmed' : '') + '" onclick="window.location=\'' + clickUrl + '\'">';
      h += '<span class="stage">' + stageName + '</span>';
      h += '<span class="teams">' + flagHtml(home, 'sm') + '<span style="' + (homeW ? 'font-weight:700' : '') + '">' + (home?.name || m.home) + '</span>';
      h += ' <span style="color:var(--text-muted)">vs</span> ';
      h += flagHtml(away, 'sm') + '<span style="' + (awayW ? 'font-weight:700' : '') + '">' + (away?.name || m.away) + '</span></span>';
      if (m.finished && m.g1 != null) {
        h += '<span class="score">' + m.g1 + '-' + m.g2 + '</span>';
      } else {
        h += '<span class="time">' + (m.time || '即将') + '</span>';
        if (isConfirmed) h += '<span class="badge-real" style="font-size:0.62rem">已确认</span>';
        else h += '<span class="badge-pred" style="font-size:0.62rem">预测</span>';
      }
      h += '</div>';
      return h;
    }

    document.getElementById('ko-finished').innerHTML = finished.length
      ? finished.map(matchRow).join('')
      : '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无已完赛淘汰赛</div>';
    document.getElementById('ko-upcoming').innerHTML = upcoming.length
      ? upcoming.map(matchRow).join('')
      : '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无可预测的淘汰赛</div>';
  }

  // ===== 渲染16强队伍（区分真实晋级 vs MC预测） =====
  function renderR16Teams(bracketRoundData, teamsProb) {
    var container = document.getElementById('ko-r16-teams');
    var r32 = bracketRoundData.round32 || [];
    // 区分：已完赛R32的胜者是"真实晋级"，未赛比赛的胜者是"MC预测"
    var realWinners = {}, predWinners = {};
    r32.forEach(function(m) {
      if (m.winner) {
        if (m.finished && m.g1 != null) realWinners[m.winner] = true;
        else predWinners[m.winner] = true;
      }
    });
    var allSlugs = Object.keys(realWinners).concat(Object.keys(predWinners));
    if (!allSlugs.length) {
      container.innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无16强数据</div>';
      return;
    }
    var html = '';
    allSlugs.forEach(function(slug) {
      var isReal = realWinners[slug];
      var t = teamsProb[slug] || {};
      var info = { flagPath: t.flagPath, flag: t.flag, name: t.name || slug };
      html += '<div class="qualified-team ' + (isReal ? 'real' : 'predicted') + '">' +
        flagHtml(info, 'md') +
        '<span>' + (t.name || slug) + '</span>' +
        '<span class="rank-label">' + (t.round16 ? t.round16.toFixed(1) + '%' : '') + '</span>' +
        (isReal ? '<span class="badge-real">✅ 已晋级</span>' : '<span class="badge-pred">🔮 预测</span>') +
        '</div>';
    });
    container.innerHTML = html;
  }

