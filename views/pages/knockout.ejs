  // ===== 渲染半决赛对阵 =====
  function renderSemiMatches(roundData, teamsProb) {
    var container = document.getElementById('ko-semi-matches');
    var semis = roundData.semi || [];
    if (!semis.length) {
      container.innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无半决赛数据</div>';
      return;
    }
    var html = '';
    semis.forEach(function(m, idx) {
      var home = m.homeInfo, away = m.awayInfo;
      var finished = m.finished;
      var winnerSlug = m.winner;
      var homeW = winnerSlug && m.home === winnerSlug;
      var awayW = winnerSlug && m.away === winnerSlug;
      var homeProb = home ? (teamsProb[home?.name ? (Object.keys(teamsProb).find(function(k) { return teamsProb[k].name === home.name; })) : m.home]?.final || 0) : 0;
      var awayProb = away ? (teamsProb[away?.name ? (Object.keys(teamsProb).find(function(k) { return teamsProb[k].name === away.name; })) : m.away]?.final || 0) : 0;
      // 简化：从 teamsProb 中按 slug 查 final% (MC 决赛概率)
      if (m.home) {
        var t = teamsProb[m.home];
        if (t) homeProb = t.final || 0;
      }
      if (m.away) {
        var t2 = teamsProb[m.away];
        if (t2) awayProb = t2.final || 0;
      }
      var statusHtml = '';
      if (finished) {
        statusHtml = '<span class="live">✅ 已完赛</span> · ' + (m.time || '');
      } else if (m.home && m.away && !m.home.startsWith('W') && !m.away.startsWith('W')) {
        statusHtml = '<span class="live">⏰ ' + (m.time || '即将开赛') + '</span>';
      } else {
        statusHtml = '<span style="color:var(--text-muted)">🔮 待定</span>';
      }
      var scoreHtml = '';
      if (finished && m.g1 != null && m.g2 != null) {
        scoreHtml = '<div class="score-line">' + m.g1 + ' &nbsp;-&nbsp; ' + m.g2 + '</div>';
        if (m.pens1 != null && m.pens2 != null) {
          scoreHtml += '<div class="pens">点球 ' + m.pens1 + '-' + m.pens2 + '</div>';
        }
      } else {
        scoreHtml = '<div class="vs-text">VS</div>';
      }
      var footerBadge = finished
        ? '<span class="badge real">✅ 实际结果</span>'
        : '<span class="badge pred">🔮 MC 预测</span>';
      html += '<div class="big-match">' +
        '<div class="big-match-header">' +
          '<span class="big-match-label">⚔️ 半决赛 ' + (idx + 1) + ' · ' + (m.slot || '') + '</span>' +
          '<span class="big-match-status">' + statusHtml + '</span>' +
        '</div>' +
        '<div class="big-match-body">' +
          '<div class="big-team home' + (homeW ? ' winner' : '') + '">' +
            '<span class="team-flag-lg">' + flagHtml(home, 'md') + '</span>' +
            '<div class="name-block">' +
              '<span class="team-name">' + (home?.name || (m.home && !m.home.startsWith('W') ? m.home : '待定')) + '</span>' +
              '<span class="team-meta">' +
                (home?.elo ? '<span class="path-pill">Elo ' + home.elo + '</span>' : '') +
                (home?.group ? '<span class="path-pill">' + home.group + '组</span>' : '') +
              '</span>' +
            '</div>' +
          '</div>' +
          '<div class="big-score">' + scoreHtml + '</div>' +
          '<div class="big-team away' + (awayW ? ' winner' : '') + '">' +
            '<span class="team-flag-lg">' + flagHtml(away, 'md') + '</span>' +
            '<div class="name-block">' +
              '<span class="team-name">' + (away?.name || (m.away && !m.away.startsWith('W') ? m.away : '待定')) + '</span>' +
              '<span class="team-meta">' +
                (away?.elo ? '<span class="path-pill">Elo ' + away.elo + '</span>' : '') +
                (away?.group ? '<span class="path-pill">' + away.group + '组</span>' : '') +
              '</span>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="big-match-footer">' +
          '<div class="prob">' +
            '<span>' + (home?.name || (m.home && !m.home.startsWith('W') ? m.home : '待定')) + ' <b>' + (homeProb ? homeProb.toFixed(1) + '%' : '-') + '</b></span>' +
            '<span>' + (away?.name || (m.away && !m.away.startsWith('W') ? m.away : '待定')) + ' <b>' + (awayProb ? awayProb.toFixed(1) + '%' : '-') + '</b></span>' +
          '</div>' +
          footerBadge +
        '</div>' +
      '</div>';
    });
    container.innerHTML = html;
  }

  // ===== 渲染季军赛 & 决赛 =====
  function renderFinalsMatches(roundData, teamsProb) {
    var container = document.getElementById('ko-finals-matches');
    var semis = roundData.semi || [];
    var finalM = (roundData.final || [])[0] || null;
    if (!finalM && !semis.length) {
      container.innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无决赛数据</div>';
      return;
    }

    // === 构造季军赛对阵 ===
    // 季军赛 = SF1 败者 vs SF2 败者
    var thirdMatch = null;
    if (semis.length === 2) {
      var sf1 = semis[0], sf2 = semis[1];
      function loser(m) {
        if (!m || !m.winner || !m.home || !m.away) return null;
        if (m.home.startsWith('W') || m.away.startsWith('W')) return null;
        return m.winner === m.home ? m.away : m.home;
      }
      var sf1Loser = loser(sf1);
      var sf2Loser = loser(sf2);
      // 只要有一方败者已确定即可展示（另一方显示"待定"）
      if (sf1Loser || sf2Loser) {
        var homeTeam = sf1Loser || null;
        var awayTeam = sf2Loser || null;
        var homeInfo = homeTeam ? { name: teamsProb[homeTeam]?.name || homeTeam, flag: teamsProb[homeTeam]?.flag, flagPath: teamsProb[homeTeam]?.flagPath, group: teamsProb[homeTeam]?.group, elo: teamsProb[homeTeam]?.elo || 1500 } : null;
        var awayInfo = awayTeam ? { name: teamsProb[awayTeam]?.name || awayTeam, flag: teamsProb[awayTeam]?.flag, flagPath: teamsProb[awayTeam]?.flagPath, group: teamsProb[awayTeam]?.group, elo: teamsProb[awayTeam]?.elo || 1500 } : null;
        var predictedThird = null;
        if (sf1Loser && sf2Loser) {
          // 双方都确定时，用 final 概率预测季军胜者
          var f1 = teamsProb[sf1Loser]?.final || 0;
          var f2 = teamsProb[sf2Loser]?.final || 0;
          predictedThird = f1 >= f2 ? sf1Loser : sf2Loser;
        } else if (sf1Loser) {
          predictedThird = sf1Loser;
        } else {
          predictedThird = sf2Loser;
        }
        thirdMatch = {
          home: sf1Loser || '待定',
          away: sf2Loser || '待定',
          homeInfo: homeInfo || { name: '待定', flag: '\u26bd', flagPath: null, group: '', elo: 1500 },
          awayInfo: awayInfo || { name: '待定', flag: '\u26bd', flagPath: null, group: '', elo: 1500 },
          winner: predictedThird,
          finished: false,
          slot: '3RD',
          label: '季军赛',
        };
      }
    }

    function bigMatchCard(m, opts) {
      opts = opts || {};
      var klass = 'big-match';
      if (opts.final) klass += ' final';
      if (opts.third) klass += ' third';
      var home = m.homeInfo, away = m.awayInfo;
      var finished = m.finished;
      var winnerSlug = m.winner;
      var homeW = winnerSlug && m.home === winnerSlug;
      var awayW = winnerSlug && m.away === winnerSlug;
      var homeProb = m.home ? (teamsProb[m.home]?.champion || 0) : 0;
      var awayProb = m.away ? (teamsProb[m.away]?.champion || 0) : 0;
      var statusHtml = '';
      if (finished) {
        statusHtml = '<span class="live">✅ 已完赛</span>';
      } else if (m.home && m.away && !m.home.startsWith('W') && !m.away.startsWith('W') && m.home !== '待定' && m.away !== '待定') {
        statusHtml = '<span class="live">⏰ ' + (m.time || '即将开赛') + '</span>';
      } else {
        statusHtml = '<span style="color:var(--text-muted)">🔮 待定</span>';
      }
      var scoreHtml = '';
      if (finished && m.g1 != null && m.g2 != null) {
        scoreHtml = '<div class="score-line">' + m.g1 + ' &nbsp;-&nbsp; ' + m.g2 + '</div>';
        if (m.pens1 != null && m.pens2 != null) {
          scoreHtml += '<div class="pens">点球 ' + m.pens1 + '-' + m.pens2 + '</div>';
        }
      } else {
        scoreHtml = '<div class="vs-text">VS</div>';
      }
      var footerBadge = finished
        ? '<span class="badge real">✅ 实际结果</span>'
        : '<span class="badge pred">🔮 MC 预测</span>';
      var labelText = opts.final ? '🏆 总决赛' : (opts.third ? '🥉 季军赛' : (m.label || ''));
      return '<div class="' + klass + '">' +
        '<div class="big-match-header">' +
          '<span class="big-match-label">' + labelText + (m.slot ? ' · ' + m.slot : '') + '</span>' +
          '<span class="big-match-status">' + statusHtml + '</span>' +
        '</div>' +
        '<div class="big-match-body">' +
          '<div class="big-team home' + (homeW ? ' winner' : '') + '">' +
            '<span class="team-flag-lg">' + flagHtml(home, 'md') + '</span>' +
            '<div class="name-block">' +
              '<span class="team-name">' + (home?.name || (m.home && !m.home.startsWith('W') ? m.home : '待定')) + '</span>' +
              '<span class="team-meta">' +
                (home?.elo ? '<span class="path-pill">Elo ' + home.elo + '</span>' : '') +
                (home?.group ? '<span class="path-pill">' + home.group + '组</span>' : '') +
              '</span>' +
            '</div>' +
          '</div>' +
          '<div class="big-score">' + scoreHtml + '</div>' +
          '<div class="big-team away' + (awayW ? ' winner' : '') + '">' +
            '<span class="team-flag-lg">' + flagHtml(away, 'md') + '</span>' +
            '<div class="name-block">' +
              '<span class="team-name">' + (away?.name || (m.away && !m.away.startsWith('W') ? m.away : '待定')) + '</span>' +
              '<span class="team-meta">' +
                (away?.elo ? '<span class="path-pill">Elo ' + away.elo + '</span>' : '') +
                (away?.group ? '<span class="path-pill">' + away.group + '组</span>' : '') +
              '</span>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="big-match-footer">' +
          '<div class="prob">' +
            '<span>' + (home?.name || (m.home && !m.home.startsWith('W') ? m.home : '待定')) + ' 冠军概率 <b>' + (homeProb ? homeProb.toFixed(1) + '%' : '-') + '</b></span>' +
            '<span>' + (away?.name || (m.away && !m.away.startsWith('W') ? m.away : '待定')) + ' 冠军概率 <b>' + (awayProb ? awayProb.toFixed(1) + '%' : '-') + '</b></span>' +
          '</div>' +
          footerBadge +
        '</div>' +
      '</div>';
    }

    var html = '';
    if (thirdMatch) {
      html += bigMatchCard(thirdMatch, { third: true });
    } else {
      html += '<div class="big-match third"><div class="big-match-body"><div class="big-team" style="grid-column:1/-1;text-align:center;justify-content:center"><div class="name-block"><span class="team-name" style="color:var(--text-muted)">🥉 季军赛对阵待半决赛完赛后确定</span></div></div></div></div>';
    }
    if (finalM) {
      html += bigMatchCard(finalM, { final: true });
    } else {
      html += '<div class="big-match final"><div class="big-match-body"><div class="big-team" style="grid-column:1/-1;text-align:center;justify-content:center"><div class="name-block"><span class="team-name" style="color:var(--text-muted)">🏆 决赛对阵待半决赛完赛后确定</span></div></div></div></div>';
    }
    container.innerHTML = html;
  }

  // ===== 渲染32强球队 =====
  function renderQualified(qualifiers) {
    var container = document.getElementById('ko-qualified');
    if (!qualifiers || !qualifiers.length) {
      container.innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无32强数据</div>';
      return;
    }
    var html = '';
    qualifiers.forEach(function(t) {
      var info = { flagPath: t.flagPath, flag: t.flag, name: t.name || t.slug };
      html += '<div class="qualified-team">' +
        flagHtml(info, 'md') +
        '<span>' + (t.name || t.slug) + '</span>' +
        '<span class="rank-label">' + (t.group || '') + (t.rank || '') + '</span>' +
        '</div>';
    });
    container.innerHTML = html;
  }

  // ===== 渲染第三名竞争 =====
  function renderThirdRank(thirdPlaces) {
    var container = document.getElementById('ko-third-table-container');
    var note = document.getElementById('ko-third-note');
    if (!thirdPlaces || !thirdPlaces.length) {
      container.innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无第三名数据</div>';
      note.textContent = '小组赛尚未完赛，第三名待各小组确定';
      return;
    }
    // Sort: points desc, GD desc, GF desc
    var sorted = thirdPlaces.slice().sort(function(a, b) {
      if (b.pts !== a.pts) return b.pts - a.pts;
      if (b.gd !== a.gd) return b.gd - a.gd;
      return b.gf - a.gf;
    });
    var html = '<table class="third-table"><thead><tr><th>#</th><th>球队</th><th>组</th><th>积分</th><th>净胜球</th><th>进球</th><th>状态</th></tr></thead><tbody>';
    sorted.forEach(function(t, i) {
      var qualifies = i < 8;
      var border = i === 8 ? ' border-row' : '';
      var cls = qualifies ? ' qualify-row' : '';
      var info = { flagPath: t.flagPath, flag: t.flag, name: t.name || t.slug };
      html += '<tr class="' + cls + border + '"><td>' + (i + 1) + '</td><td>' + flagHtml(info, 'sm') + ' ' + (t.name || t.slug) + '</td><td>' + (t.group || '') + '</td><td>' + (t.pts || 0) + '</td><td>' + (t.gd || 0) + '</td><td>' + (t.gf || 0) + '</td><td>' + (qualifies ? '✅ 晋级' : '❌ 淘汰') + '</td></tr>';
    });
    html += '</tbody></table>';
    container.innerHTML = html;
    note.textContent = '前8名晋级淘汰赛（绿色行）。小组全部完赛后自动更新。';
  }

  // ===== 主加载函数 =====
  async function loadKnockoutData(force) {
    if (force) {
      document.getElementById('loading-spinner').style.display = 'flex';
      document.getElementById('ko-dashboard').style.display = 'none';
    }
    try {
      var [knockoutRes, qualifiersRes, thirdRes, bracketRes] = await Promise.all([
        cachedFetch('/api/knockout/bracket', { force: force }),
        cachedFetch('/api/knockout/qualifiers', { force: force }).catch(function() { return null; }),
        cachedFetch('/api/knockout/third-rank', { force: force }).catch(function() { return null; }),
        cachedFetch('/api/bracket', { force: force }).catch(function() { return null; }),
      ]);

      document.getElementById('loading-spinner').style.display = 'none';
      document.getElementById('ko-dashboard').style.display = 'flex';

      var knockoutData = knockoutRes;
      // 基础数据：用 /api/knockout/bracket 的 rounds（含 homeInfo/awayInfo 的 R32/R16/QF）
      var roundData = (knockoutData.rounds || {});
      var teamsProb = (bracketRes && bracketRes.teams) ? bracketRes.teams : (knockoutData.teams || {});

      // 智能合并 SF/Final 数据：优先用 /api/knockout/bracket 的已解析数据
      // 只在 W-slot 未解析时，才用 /api/bracket 补全
      if (roundData && bracketRes && bracketRes.rounds) {
        ['semi', 'final'].forEach(function(stage) {
          if (roundData[stage] && bracketRes.rounds[stage]) {
            roundData[stage].forEach(function(m, i) {
              var brm = bracketRes.rounds[stage][i];
              if (brm) {
                // 只在 knockoutData 的 home/away 是 W-slot（未解析）时，才用 bracketRes 补全
                var homeUnresolved = !m.home || m.home.startsWith('W');
                var awayUnresolved = !m.away || m.away.startsWith('W');
                if (homeUnresolved && brm.home && !brm.home.startsWith('W')) {
                  m.home = brm.home;
                  m.homeInfo = brm.homeInfo || m.homeInfo;
                }
                if (awayUnresolved && brm.away && !brm.away.startsWith('W')) {
                  m.away = brm.away;
                  m.awayInfo = brm.awayInfo || m.awayInfo;
                }
                // 已完赛数据：以 /api/knockout/bracket 为准（它有真实比分）
                if (m.finished && m.g1 != null && m.g2 != null) {
                  // 保留 knockoutData 的真实数据，不被 bracketRes 覆盖
                } else if (brm.finished && brm.g1 != null && brm.g2 != null) {
                  m.winner = brm.winner;
                  m.finished = brm.finished;
                  m.g1 = brm.g1;
                  m.g2 = brm.g2;
                }
              }
            });
          }
        });
      }

      // ===== 实时数据补丁：直接从赛程 API 获取 SF/Final 真实球队 =====
      // 即使 bracket 解析失败，也能用 schedule API 拿到最新对局
      try {
        var scheduleRes = await cachedFetch('/api/matches/schedule', { force: force }).catch(function() { return null; });
        if (scheduleRes && scheduleRes.matches) {
          var byStage = { SEMI_FINALS: 'semi', FINAL: 'final', THIRD_PLACE: 'third' };
          Object.keys(byStage).forEach(function(apiStage) {
            var stageKey = byStage[apiStage];
            var stageMatches = (scheduleRes.matches || []).filter(function(m) { return m.stage === apiStage; });
            if (stageMatches.length && roundData[stageKey]) {
              stageMatches.forEach(function(sm, idx) {
                var bm = roundData[stageKey][idx];
                if (!bm) return;
                // 如果还缺球队，从 schedule 补全
                if ((!bm.home || bm.home.startsWith('W') || !bm.away || bm.away.startsWith('W')) && sm.t1 && sm.t2) {
                  bm.home = sm.t1;
                  bm.away = sm.t2;
                  if (sm.team1Info) bm.homeInfo = { ...sm.team1Info, elo: 1500 };
                  if (sm.team2Info) bm.awayInfo = { ...sm.team2Info, elo: 1500 };
                  if (sm.status === 'FT' && sm.g1 != null && sm.g2 != null) {
                    bm.g1 = sm.g1;
                    bm.g2 = sm.g2;
                    bm.finished = true;
                    bm.winner = sm.g1 > sm.g2 ? sm.t1 : sm.t2;
                  }
                  if (sm.time) bm.time = sm.time;
                }
              });
            }
          });
        }
      } catch (schedErr) {
        console.warn('[knockout] schedule API merge failed:', schedErr.message);
      }

      // Source banner
      var banner = document.getElementById('source-banner');
      var bannerText = document.getElementById('source-banner-text');
      var freshnessEl = document.getElementById('ko-freshness');
      if (knockoutData.source === 'real') {
        bannerText.textContent = '✅ 淘汰赛对阵基于实时小组赛/淘汰赛结果';
        banner.className = 'success-banner';
      } else {
        bannerText.textContent = '⚠️ 淘汰赛对阵基于蒙特卡洛模拟';
        banner.className = 'disclaimer-banner';
      }
      // 显示数据新鲜度（包含服务端的实际生成时间）
      var generatedAt = null;
      if (knockoutRes._cache && knockoutRes._cache.createdAt) {
        generatedAt = knockoutRes._cache.createdAt;
      } else if (knockoutRes._cache && knockoutRes._cache.hitAt) {
        generatedAt = knockoutRes._cache.hitAt;
      } else if (knockoutRes.generatedAt) {
        generatedAt = knockoutRes.generatedAt;
      }
      if (generatedAt) {
        var dt = new Date(generatedAt);
        var localStr = dt.toLocaleString('zh-CN', { hour12: false });
        var secondsAgo = Math.floor((Date.now() - dt.getTime()) / 1000);
        var ageStr = '';
        if (secondsAgo < 600) ageStr = secondsAgo + ' 秒前';
        else if (secondsAgo < 3600) ageStr = Math.floor(secondsAgo / 60) + ' 分钟前';
        else ageStr = Math.floor(secondsAgo / 3600) + ' 小时前';
        freshnessEl.innerHTML = '🕐 数据生成: ' + localStr + ' <b style="color:var(--accent)">(' + ageStr + ')</b>';
      }
      // 显示 force 状态
      if (force) {
        freshnessEl.innerHTML += ' <span style="color:var(--accent)">[已强制刷新]</span>';
      }
      banner.style.display = 'flex';

      // 新数据检测：对比上一次的 finished 比赛数
      if (window._prevFinishedCount === undefined) {
        window._prevFinishedCount = 0;
      }
      var currentFinishedCount = 0;
      ['round32', 'round16', 'quarter', 'semi', 'final'].forEach(function(stage) {
        (roundData[stage] || []).forEach(function(m) {
          if (m.finished && m.g1 != null && m.g2 != null) currentFinishedCount++;
        });
      });
      if (window._prevFinishedCount > 0 && currentFinishedCount > window._prevFinishedCount) {
        var diff = currentFinishedCount - window._prevFinishedCount;
        var note = document.createElement('div');
        note.className = 'success-banner';
        note.style.cssText = 'margin-bottom:8px;animation: pulse 1s 3';
        note.innerHTML = '🔔 检测到 ' + diff + ' 场新增完赛！已自动应用最新结果。';
        var dashboard = document.getElementById('ko-dashboard');
        if (dashboard && dashboard.parentNode) {
          dashboard.parentNode.insertBefore(note, dashboard);
          setTimeout(function() { note.remove(); }, 8000);
        }
      }
      window._prevFinishedCount = currentFinishedCount;

      // Summary
      var totalTeams = knockoutData.totalQualified || Object.keys(teamsProb).length || 0;
      document.getElementById('ko-summary').textContent = '2026世界杯 · ' + totalTeams + ' 支球队 · ' + (knockoutData.source === 'real' ? '实时数据' : '蒙特卡洛模拟');

      // Render panels
      renderBracketTree(roundData, teamsProb);
      if (roundData && roundData.round32) {
        renderMatchList(roundData, teamsProb);
        renderR16Teams(roundData, teamsProb);
        renderQuarterTeams(roundData, teamsProb);
        renderSemiTeams(roundData, teamsProb);
        renderSemiMatches(roundData, teamsProb);
        renderFinalsMatches(roundData, teamsProb);
      } else {
        document.getElementById('ko-finished').innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无比赛数据</div>';
        document.getElementById('ko-upcoming').innerHTML = '';
        document.getElementById('ko-semi-matches').innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无半决赛数据</div>';
        document.getElementById('ko-finals-matches').innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">暂无决赛数据</div>';
      }

      // Qualified teams
      if (qualifiersRes && qualifiersRes.qualifiers && qualifiersRes.qualifiers.allTeams) {
        renderQualified(qualifiersRes.qualifiers.allTeams);
      } else {
        // Derive from bracket data
        var slugs = [];
        Object.keys(roundData).forEach(function(stage) {
          (roundData[stage] || []).forEach(function(m) {
            if (m.homeInfo && slugs.indexOf(m.home) < 0) slugs.push(m.home);
            if (m.awayInfo && slugs.indexOf(m.away) < 0) slugs.push(m.away);
          });
        });
        renderQualified(slugs.map(function(s) {
          var info = knockoutData._teamIndex && knockoutData._teamIndex[s];
          return { slug: s, name: info?.name || s, flag: info?.flag, flagPath: info?.flagPath, group: info?.group };
        }));
      }

      // Third-rank
      if (thirdRes && thirdRes.spots) {
        renderThirdRank(thirdRes.spots);
      } else {
        document.getElementById('ko-third-table-container').innerHTML = '<div style="color:var(--text-muted);font-size:0.82rem;padding:8px">第三名数据待各小组完赛后可用</div>';
      }

      // Draw SVG lines
      if (window.drawBracketLines) {
        setTimeout(function() { window.drawBracketLines(roundData, teamsProb); }, 100);
      }
    } catch (err) {
      document.getElementById('loading-spinner').innerHTML = '⚠️ 数据加载失败: ' + err.message;
    }
  }

  window.cacheUI.onRefresh('knockout', function() { loadKnockoutData(true); });
  loadKnockoutData(false);

  // ===== 自动定时刷新（确保数据实时性）=====
  // 60 秒自动拉取一次；点击手动刷新按钮时重置计时
  var autoRefreshSeconds = 60;
  var autoRefreshTimer = null;
  var autoRefreshRemaining = autoRefreshSeconds;
  var autoRefreshEl = document.getElementById('ko-auto-refresh');

  function updateAutoRefreshLabel() {
    if (!autoRefreshEl) return;
    if (autoRefreshRemaining <= 0) {
      autoRefreshEl.textContent = '⏱️ 即将刷新...';
      return;
    }
    autoRefreshEl.textContent = '⏱️ ' + autoRefreshRemaining + 's 后自动刷新';
  }

  function scheduleAutoRefresh() {
    if (autoRefreshTimer) clearInterval(autoRefreshTimer);
    autoRefreshRemaining = autoRefreshSeconds;
    autoRefreshTimer = setInterval(function() {
      autoRefreshRemaining--;
      updateAutoRefreshLabel();
      if (autoRefreshRemaining <= 0) {
        clearInterval(autoRefreshTimer);
        autoRefreshTimer = null;
        // 自动刷新（带 force 标记，绕过服务端缓存）
        loadKnockoutData(true).then(function() {
          autoRefreshRemaining = autoRefreshSeconds;
          updateAutoRefreshLabel();
          scheduleAutoRefresh();
        });
      }
    }, 1000);
    updateAutoRefreshLabel();
  }
  scheduleAutoRefresh();

  // 页面可见性变化时立即刷新（用户切回标签页时）
  document.addEventListener('visibilitychange', function() {
    if (!document.hidden && autoRefreshTimer === null) {
      loadKnockoutData(true).then(function() {
        autoRefreshRemaining = autoRefreshSeconds;
        scheduleAutoRefresh();
      });
    }
  });
  </script>
</body>
</html>
