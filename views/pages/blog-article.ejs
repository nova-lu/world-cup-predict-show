<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <style>
    .article-back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #4a8bc2;
      font-size: 0.9rem;
      text-decoration: none;
      margin-bottom: 20px;
    }
    .article-back-link:hover { text-decoration: underline; }
    .article-header { margin-bottom: 28px; }
    .article-meta { font-size: 0.85rem; color: #6a7a8e; margin-bottom: 10px; }
    .article-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .article-tag {
      display: inline-block; background: #2a3a4e; color: #8ab8e0;
      font-size: 0.78rem; padding: 3px 10px; border-radius: 999px;
    }
    .article-body { line-height: 1.8; color: #c8d8e8; font-size: 1rem; }
    .article-body h2 { font-size: 1.3rem; color: #e0e8f0; margin: 28px 0 12px; border-bottom: 1px solid #2a3a4e; padding-bottom: 8px; }
    .article-body h3 { font-size: 1.1rem; color: #d0dce8; margin: 22px 0 10px; }
    .article-body p { margin-bottom: 16px; }
    .article-body .hl-box {
      background: #1a2738; border-left: 4px solid #4a8bc2;
      padding: 16px 18px; border-radius: 6px; margin: 18px 0; color: #b0c8e0;
    }
    .article-body table.dtbl {
      width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 0.9rem;
    }
    .article-body table.dtbl th, .article-body table.dtbl td {
      border: 1px solid #2a3a4e; padding: 8px 12px; text-align: center;
    }
    .article-body table.dtbl th { background: #1a2738; color: #8ab8e0; font-weight: 600; }
    .article-body table.dtbl td { color: #b0c8e0; }
    .article-body ul, .article-body ol { margin: 10px 0 16px 22px; color: #c0d0e0; }
    .article-body li { margin-bottom: 6px; }
    .article-body strong { color: #e8f0f8; }
    .article-footer-nav {
      margin-top: 40px; padding-top: 20px; border-top: 1px solid #2a3a4e;
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    }
    .article-footer-nav a { color: #4a8bc2; text-decoration: none; font-size: 0.9rem; }
    .article-footer-nav a:hover { text-decoration: underline; }
    @media (max-width: 600px) { .article-body { font-size: 0.95rem; } }
  </style>
</head>
